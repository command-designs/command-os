#!/bin/sh
# Command OS — bloquea la sesión (lo llama hypridle con Super+L, al suspender y por inactividad).
# Un bloqueo que falla deja el equipo abierto, y uno sin campo de contraseña deja al usuario sin
# saber cómo entrar, así que hay tres niveles:
#   1. hyprlock con su configuración (la del usuario o la de serie, /etc/xdg/hypr/hyprlock.conf);
#   2. si esa configuración tiene errores (p. ej. una actualización cambió su formato), hyprlock con
#      una de emergencia que solo usa opciones básicas. Con errores, hyprlock no sale: bloquea con
#      la pantalla en negro y sin campo. Por eso se revisa antes de bloquear;
#   3. si hyprlock no funciona (librería rota tras una actualización), swaylock.
# Si fallan los tres, la sesión no se puede bloquear: se registra como crítico, se avisa en pantalla
# y se sale con error.

run="${XDG_RUNTIME_DIR:-}"
# Una sola instancia: la que está bloqueando guarda el cerrojo hasta que se desbloquea. (pidof no
# sirve: la revisión de abajo también es un proceso hyprlock.)
if [ -n "${run}" ] && [ -d "${run}" ] && [ -O "${run}" ]; then
  exec 9>"${run}/command-os-lock.cerrojo"
  flock -n 9 || exit 0
fi
pidof swaylock >/dev/null 2>&1 && exit 0

cfg="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprlock.conf"
[ -e "${cfg}" ] || cfg=/etc/xdg/hypr/hyprlock.conf
emergencia=/usr/share/command-os/config/hypr/hyprlock-emergencia.conf

# Alta densidad: hyprlock no aplica la escala de la pantalla; la configuración de serie se le da
# con las medidas escaladas (command-os-pantallas hyprlock). La de una cuenta se usa tal cual. Va
# antes de la revisión: se revisa la configuración que de verdad se va a usar.
if [ "${cfg}" = /etc/xdg/hypr/hyprlock.conf ] && [ -n "${run}" ] && [ -d "${run}" ] && [ -O "${run}" ]; then
  escalada="${run}/command-os-hyprlock.conf"
  if command-os-pantallas hyprlock "${cfg}" > "${escalada}.nueva" 2>/dev/null && [ -s "${escalada}.nueva" ]; then
    mv -f "${escalada}.nueva" "${escalada}" && cfg="${escalada}"
  else
    rm -f "${escalada}.nueva"
  fi
fi

# Revisión sin bloquear: hyprlock lee la configuración antes de conectarse a la pantalla; contra una
# pantalla que no existe, informa de los errores y aborta (sin volcado: ulimit -c 0). El resultado
# se guarda en la carpeta privada del usuario hasta que cambian la configuración o hyprlock (así no
# se repite en cada bloqueo); sin carpeta privada, se revisa siempre.
revisar() {
  if (ulimit -c 0; exec 2>&1; WAYLAND_DISPLAY=command-os-revision-sin-pantalla exec hyprlock --config "${cfg}") \
      | grep -q 'Config error'; then echo mal; else echo bien; fi
}
if [ -n "${run}" ] && [ -d "${run}" ] && [ -O "${run}" ]; then
  huella=$( { cat "${cfg}" 2>/dev/null; stat -c %Y /usr/bin/hyprlock 2>/dev/null; } | cksum | cut -d' ' -f1)
  revision="${run}/command-os-lock.${huella}"
  [ -f "${revision}" ] && [ ! -L "${revision}" ] || revisar > "${revision}"
  estado=$(cat "${revision}")
else
  estado=$(revisar)
fi
if [ "${estado}" = mal ]; then
  logger -t command-os-lock "la configuración de hyprlock (${cfg}) tiene errores; se usa la de emergencia"
  cfg="${emergencia}"
fi

hyprlock --config "${cfg}" && exit 0
if [ "${cfg}" != "${emergencia}" ]; then
  logger -t command-os-lock "hyprlock salió con error; se usa la configuración de emergencia"
  hyprlock --config "${emergencia}" && exit 0
fi
logger -t command-os-lock "hyprlock no funciona; se usa swaylock"
swaylock --color 0d0b0e --inside-color 15121a --ring-color d13449 \
  --key-hl-color 5bbfc4 --text-color edebe6 --indicator-radius 80 --show-failed-attempts && exit 0

logger -p auth.crit -t command-os-lock "NO SE HA PODIDO BLOQUEAR LA SESIÓN: fallan hyprlock y swaylock"
notify-send -u critical "› la sesión no se ha podido bloquear" \
  "fallan hyprlock y swaylock; revisar con: journalctl -t command-os-lock" 2>/dev/null
exit 1
