#!/usr/bin/env bash
# Command OS — fondo de pantalla (build/make-wallpaper.py).
#   command-os-wallpaper           aplica el elegido (o el de serie, retícula); lo llama autostart
#   command-os-wallpaper elegir    menú para cambiarlo (ajustes → fondo de pantalla)
# La elección se guarda en ~/.config/command-os/wallpaper.
set -uo pipefail
source /usr/lib/command-os/textos.sh

DIR=/usr/share/command-os/wallpapers
STATE="${XDG_CONFIG_HOME:-$HOME/.config}/command-os/wallpaper"
STYLE="$(command-os-config wofi/power.css)"
TAG="command-os-wallpaper"
NAMES=(reticula plano)
declare -A LABEL=([reticula]="$(t 'retícula')" [plano]="$(t 'plano')")

current() {
  local name
  name=$(cat "${STATE}" 2>/dev/null)
  # Solo los de la lista: un fondo de antes de la marca v2 (interfaz, núcleo, placa) vuelve al de serie.
  [[ " ${NAMES[*]} " == *" ${name} "* && -f "${DIR}/command-${name}.png" ]] || name=reticula
  printf '%s' "${name}"
}

apply() {  # arranca el nuevo swaybg y después cierra el anterior: sin parpadeo
  local old args name w h
  old=$(pgrep -x swaybg)
  # Cada fondo existe en 16:9 y en 16:10: cada pantalla recibe el más cercano a su proporción, sin
  # recortar ni deformar (4:3 y 5:4 también toman el 16:10, que es el que menos recorta).
  args=(-o '*' -m fill -c '#0e0e0e' -i "${DIR}/command-$1.png")
  if [[ -f "${DIR}/command-$1-16x10.png" ]]; then
    while read -r name w h _; do
      if [[ -n "${h}" ]] && (( h > 0 && w * 100 / h < 170 )); then
        args+=(-o "${name}" -m fill -c '#0e0e0e' -i "${DIR}/command-$1-16x10.png")
      fi
    done < <(command-os-pantallas lista 2>/dev/null)
  fi
  swaybg "${args[@]}" >/dev/null 2>&1 &
  disown
  if [[ -n "${old}" ]]; then
    sleep 0.5
    kill ${old} 2>/dev/null
  fi
}

case "${1:-}" in
  "")
    apply "$(current)" ;;
  elegir)
    if pkill -f "^wofi --dmenu --prompt ${TAG}" 2>/dev/null; then exit 0; fi
    now=$(current)
    menu=()
    for n in "${NAMES[@]}"; do
      if [[ "${n}" == "${now}" ]]; then menu+=("󰄬   ${LABEL[$n]}"); else menu+=("     ${LABEL[$n]}"); fi
    done
    choice=$(printf '%s\n' "${menu[@]}" | wofi --dmenu --prompt "${TAG}" --style "${STYLE}" \
      --cache-file /dev/null --width 280 --lines ${#NAMES[@]}) || exit 0
    for n in "${NAMES[@]}"; do
      if [[ "${choice}" == *"${LABEL[$n]}" ]]; then
        mkdir -p "$(dirname "${STATE}")"
        printf '%s\n' "${n}" > "${STATE}"
        apply "${n}"
      fi
    done ;;
  *)
    echo "uso: command-os-wallpaper [elegir]" >&2
    exit 2 ;;
esac
