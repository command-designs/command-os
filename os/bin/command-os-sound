#!/bin/sh
# Reproduce un sonido de marca: command-os-sound <boot|login|notify|critical|lock|unlock|tick>
# No bloquea ni falla si no hay audio (VM sin dispositivo, PipeWire aún arrancando).
f="/usr/share/command-os/sounds/${1:?uso: command-os-sound <nombre>}.wav"
[ -r "$f" ] || exit 0
if [ "$1" = boot ]; then
  # En el arranque PipeWire puede tardar un poco en estar listo.
  i=0; while [ $i -lt 20 ] && ! pw-cli info 0 >/dev/null 2>&1; do sleep 0.5; i=$((i+1)); done
fi
exec pw-play --volume=0.8 "$f" >/dev/null 2>&1
