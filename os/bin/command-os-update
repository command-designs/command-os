#!/usr/bin/env bash
# Command OS — actualiza el sistema de forma segura (en la terminal: `update`).
#   1. Repositorios al día (fecha validada de Arch, repositorio y clave de Command OS).
#   2. Primero solo el paquete command-os: puede traer una nueva fecha validada de Arch.
#   3. Después, todo el sistema contra esa fecha (nunca se mezclan paquetes de días distintos).
#   4. Por último, las aplicaciones de la tienda (Flatpak).
# Con la raíz en btrfs, snap-pac hace una instantánea antes y otra después: si algo sale mal, se
# vuelve atrás desde el menú de arranque o con command-os-rollback.
set -euo pipefail
[[ "$(id -u)" -eq 0 ]] || exec sudo "$0" "$@"
source /usr/lib/command-os/textos.sh

/usr/lib/command-os/apply-repos
pacman -Sy
if pacman -Si command-os >/dev/null 2>&1; then
  pacman -S --needed --noconfirm command-os
fi
/usr/lib/command-os/apply-repos
pacman -Syu "$@"

# 4. Las aplicaciones de la tienda (Flatpak): van aparte del sistema y de la fecha validada, así que se
#    actualizan después, contra Flathub del día, y sin preguntar (pacman ya preguntó). Si falla (sin
#    red), lo de pacman queda hecho; se reintenta la próxima vez. Después, fuera los runtimes que ya no
#    usa ninguna aplicación. Primero las del sistema (la tienda instala ahí) y luego las que quien lanzó
#    `update` instaló solo para su cuenta (flatpak --user).
flatpak_de() {  # flatpak_de system|user ARGUMENTOS…
  local donde=$1; shift
  if [[ "${donde}" == system ]]; then
    flatpak "$@" --system
  else
    runuser -u "${SUDO_USER}" -- env HOME="$(getent passwd "${SUDO_USER}" | cut -d: -f6)" flatpak "$@" --user
  fi
}
if command -v flatpak >/dev/null; then
  for donde in system user; do
    [[ "${donde}" == user && -z "${SUDO_USER:-}" ]] && continue
    [[ -n "$(flatpak_de "${donde}" list --columns=application 2>/dev/null)" ]] || continue
    echo
    echo "$(t 'command-os: actualizando las aplicaciones de la tienda…')"
    if flatpak_de "${donde}" update --noninteractive -y; then
      flatpak_de "${donde}" uninstall --unused --noninteractive -y >/dev/null 2>&1 || true
    else
      echo "$(t 'command-os: no se pudieron actualizar las aplicaciones de la tienda; se reintentará la próxima vez.')"
    fi
  done
  # El gancho de pacman comprobó antes de actualizar las apps: sin esto, el aviso se quedaría sin
  # ellas (es anterior a /var/lib/flatpak/.changed) hasta la siguiente comprobación.
  /usr/lib/command-os/refresh-updates
fi

# Si se actualizó el kernel, el que está en marcha ya no tiene sus módulos en el disco (Arch los
# borra): hay que reiniciar para estrenar el nuevo.
if [[ ! -d "/usr/lib/modules/$(uname -r)" ]]; then
  echo
  echo "$(t 'command-os: el kernel se ha actualizado; reinicia para terminar (systemctl reboot).')"
fi
