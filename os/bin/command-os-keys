#!/usr/bin/env bash
# Command OS — chuleta de atajos (Super+F1, o "atajos de teclado" en el menú del escritorio).
# Solo informa: elegir una línea cierra el panel. Debe coincidir con ~/.config/labwc/rc.xml.
set -uo pipefail
source /usr/lib/command-os/textos.sh

STYLE="$(command-os-config wofi/power.css)"
TAG="command-os-keys"

# Si ya está abierta, el segundo atajo la cierra.
if pkill -f "^wofi --dmenu --prompt ${TAG}" 2>/dev/null; then exit 0; fi

KEYS=()
# fila TECLAS ACCIÓN: las teclas en 22 columnas (printf cuenta bytes y descuadra las flechas y el «·»).
fila() { local n=$(( 22 - ${#1} )); (( n < 1 )) && n=1; KEYS+=("$1$(printf '%*s' "${n}" '') $2"); }
# Las teclas solo se traducen donde llevan palabras (intro, mayús, impr…).
fila "super"                 "$(t 'aplicaciones')"
fila "super + $(t 'intro')"          "$(t 'terminal')"
fila "super + e"             "$(t 'archivos')"
fila "super + b"             "$(t 'navegador')"
fila "super + v"             "$(t 'portapapeles')"
fila "super + q · alt + f4"  "$(t 'cerrar ventana')"
fila "super + ↑"             "$(t 'maximizar')"
fila "super + ↓"             "$(t 'restaurar o minimizar')"
fila "super + ← / →"         "$(t 'media pantalla')"
fila "super + f"             "$(t 'pantalla completa')"
fila "super + d"             "$(t 'ver el escritorio')"
fila "super + t"             "$(t 'siempre encima')"
fila "alt + tab"             "$(t 'cambiar de ventana')"
fila "super + ctrl + d"      "$(t 'nuevo escritorio')"
fila "super + ctrl + f4"     "$(t 'quitar el último escritorio')"
fila "super + 1…4"           "$(t 'ir al escritorio')"
fila "super + $(t 'mayús') + 1…4"    "$(t 'llevar la ventana al escritorio')"
fila "super + tab"           "$(t 'siguiente escritorio')"
fila "super + l"             "$(t 'bloquear')"
fila "super + esc"           "$(t 'energía')"
fila "super + n"             "$(t 'cerrar notificaciones')"
fila "$(t 'impr') · super+$(t 'mayús')+s" "$(t 'captura de zona')"
fila "$(t 'mayús') + $(t 'impr')"   "$(t 'captura de pantalla')"
fila "ctrl + $(t 'mayús') + esc"    "$(t 'monitor del sistema')"
fila "super + $(t 'arrastrar')"     "$(t 'mover ventana')"
fila "super + $(t 'clic derecho')"  "$(t 'redimensionar ventana')"
fila "$(t 'clic derecho')"   "$(t 'menú del escritorio')"
fila "super + f1"            "$(t 'esta ayuda')"
fila "super + f2"            "$(t 'acerca de cmd-os')"

printf '%s\n' "${KEYS[@]}" | wofi --dmenu --prompt "${TAG}" --style "${STYLE}" \
  --cache-file /dev/null --width 520 --lines 13 >/dev/null
exit 0
