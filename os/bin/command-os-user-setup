#!/usr/bin/env bash
# Command OS — prepara la cuenta del usuario que inicia sesión. Lo ejecuta labwc al arrancar
# (autostart) e install.sh. Idempotente y rápido: solo crea lo que falta y nunca pisa un cambio
# hecho por el usuario.
#
# La configuración de serie vive en el sistema (/etc/xdg y /usr/share/command-os/config) y se
# actualiza con el paquete. En ~/.config solo hay:
#   - enlaces (nano) o copias (GTK) de la de serie para los programas que no saben leerla del sistema;
#     si el usuario los sustituye por un archivo propio, se respeta;
#   - lo que el propio usuario cambie (copias completas o, en labwc, solo lo que añade).
set -uo pipefail

CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
SYS=${COMMAND_OS_CONFIG:-/usr/share/command-os/config}  # otra carpeta solo en tests/aplicaciones.sh
STATE="${CFG}/command-os"
mkdir -p "${STATE}"

# --- Migración: cuentas preparadas por el install.sh anterior al paquete ---
# Aquel install.sh copiaba la configuración entera en ~/.config y la sobrescribía en cada
# ejecución, así que esas copias nunca fueron del usuario. Se quitan para que mande la de serie
# (si no, taparían las actualizaciones). Se conservan los datos del usuario (marcadores de GTK) y
# los ajustes de la máquina (teclado y perfil de VM de labwc).
if [[ ! -e "${STATE}/layout-2" ]]; then
  rm -rf "${CFG}"/{waybar,wofi,kitty,mako,alacritty,xdg-desktop-portal}
  rm -f "${CFG}"/labwc/{rc.xml,menu.xml,autostart,environment}
  rm -f "${CFG}"/hypr/{hyprlock.conf,hypridle.conf}
  rm -f "${CFG}"/gtk-3.0/{gtk.css,settings.ini} "${CFG}"/gtk-4.0/{gtk.css,settings.ini}
  rm -f "${CFG}/nano/nanorc" "${STATE}/bashrc"
  touch "${STATE}/layout-2"
fi

# --- Enlaces a la configuración de serie (solo si el usuario no tiene la suya) ---
link() {  # link destino-en-~/.config origen-en-sistema
  local dst="${CFG}/$1" src="$2"
  if [[ -L "${dst}" || ! -e "${dst}" ]]; then
    mkdir -p "$(dirname "${dst}")"
    ln -sfn "${src}" "${dst}"
  fi
}
link nano/nanorc "${SYS}/nano/nanorc"

# --- GTK: copias de la de serie, no enlaces ---
# Las apps Flatpak también leen ~/.config/gtk-3.0 y gtk-4.0 (permiso global de lib/apply-system), pero
# dentro de su caja /usr es el de su runtime: un enlace a /usr/share/command-os no llevaría a nada. Una
# copia se pone al día cuando cambia la de serie mientras el usuario no la haya tocado: la suma de la
# última que se puso queda en ~/.config/command-os/gtk/. Un enlace de antes se cambia por la copia.
copia() {  # copia destino-en-~/.config origen-en-sistema
  local dst="${CFG}/$1" src="$2" suma="${STATE}/gtk/${1//\//-}.sha256" serie actual
  [[ -r "${src}" ]] || return 0
  serie=$(sha256sum < "${src}")
  if [[ -f "${dst}" && ! -L "${dst}" ]]; then
    actual=$(sha256sum < "${dst}")
    if [[ "${actual}" == "${serie}" ]]; then
      # Igual que la de serie: es nuestra (también si la suma era de una copia anterior).
      [[ "$(cat "${suma}" 2>/dev/null)" == "${actual}" ]] || { mkdir -p "${STATE}/gtk"; echo "${actual}" > "${suma}"; }
      return 0
    fi
    # Distinta de la de serie: si es la última copia nuestra, está desfasada; si no, es del usuario.
    [[ -s "${suma}" && "${actual}" == "$(cat "${suma}")" ]] || return 0
  elif [[ -e "${dst}" && ! -L "${dst}" ]]; then
    return 0  # una carpeta u otra cosa del usuario
  fi
  # Al lado y después en su sitio: si la copia falla (disco lleno), queda la de antes.
  mkdir -p "$(dirname "${dst}")" "${STATE}/gtk"
  cp "${src}" "${dst}.nuevo" && mv -f "${dst}.nuevo" "${dst}" && echo "${serie}" > "${suma}" \
    || rm -f "${dst}.nuevo"
}
copia gtk-3.0/gtk.css "${SYS}/gtk-3.0/gtk.css"
copia gtk-3.0/settings.ini "${SYS}/gtk-3.0/settings.ini"
copia gtk-4.0/gtk.css "${SYS}/gtk-4.0/gtk.css"
copia gtk-4.0/settings.ini "${SYS}/gtk-4.0/settings.ini"
# Los chaflanes de la marca (SVG) que esas hojas buscan en chaflanes/, junto a ellas; las apps
# Flatpak no verían los de /usr/share/command-os.
for g in gtk-3.0 gtk-4.0; do
  for svg in "${SYS}/${g}/chaflanes/"*.svg; do
    [[ -r "${svg}" ]] && copia "${g}/chaflanes/$(basename "${svg}")" "${svg}"
  done
done

# --- labwc: escritorios del usuario (command-os-desktops); de serie, uno ---
if [[ ! -e "${CFG}/labwc/rc.xml" ]]; then
  mkdir -p "${CFG}/labwc"
  cat > "${CFG}/labwc/rc.xml" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!-- Ajustes de labwc de este usuario: se suman a los de serie (/etc/xdg/labwc/rc.xml).
     command-os-desktops reescribe la lista de escritorios. -->
<labwc_config>
  <desktops>
    <names>
      <name>01</name>
    </names>
  </desktops>
</labwc_config>
EOF
fi

# --- labwc: ajustes de este equipo (no de la cuenta): se regeneran siempre ---
# Teclado del equipo (/etc/command-os/kb_layout; labwc lee environment.d después de la de serie) y,
# en una VM, el perfil ligero sin sombras (render por software: cada fotograma cuenta).
mkdir -p "${CFG}/labwc/environment.d"
{
  echo '# Ajustes de este equipo. Lo genera command-os-user-setup en cada inicio de sesión.'
  if [[ -s /etc/command-os/kb_layout ]]; then
    echo "XKB_DEFAULT_LAYOUT=$(tr -d '[:space:]' < /etc/command-os/kb_layout)"
  fi
} > "${CFG}/labwc/environment.d/local.env"
if systemd-detect-virt --quiet --vm 2>/dev/null && [[ ! -e "${CFG}/labwc/themerc-override" ]]; then
  printf '%s\n' '# Perfil ligero para VM (render por software). Lo genera command-os-user-setup.' \
    'window.active.shadow.size: 0' 'window.inactive.shadow.size: 0' > "${CFG}/labwc/themerc-override"
fi

# --- Terminal: prompt y alias de Command OS en ~/.bashrc ---
BASHRC="${HOME}/.bashrc"
MARK="# --- Command OS: shell ---"
touch "${BASHRC}"
if ! grep -qF "${MARK}" "${BASHRC}"; then
  # Bloques de versiones anteriores, que apuntaban a una copia en ~/.config.
  sed -i "\|# --- Command OS: shell de desarrollo ---|,\|# --- fin Command OS ---|d" "${BASHRC}"
  printf '%s\n[ -r %s ] && . %s\n# --- fin Command OS ---\n' \
    "${MARK}" "${SYS}/bash/bashrc" "${SYS}/bash/bashrc" >> "${BASHRC}"
fi

# Sin el aviso de último acceso ni el motd al entrar en tty1 (arranque sin texto).
[[ -e "${HOME}/.hushlogin" ]] || touch "${HOME}/.hushlogin"
exit 0
