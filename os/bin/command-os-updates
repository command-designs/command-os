#!/usr/bin/env bash
# Command OS — aviso de actualizaciones en el escritorio. Solo lee lo que dejó la comprobación del
# sistema (lib/check-updates, cada 6 horas); no toca pacman.
#
#   command-os-updates status   JSON para el módulo de Waybar (custom/updates): vacío si no hay nada
#   command-os-updates panel    abre Ajustes → actualizaciones (clic en la barra): qué hay y un botón
#                               para actualizar
#   command-os-updates datos    lo mismo que enseña el panel, en líneas con tabuladores (lo lee el panel)
#   command-os-updates update   abre una terminal con command-os-update (el botón del panel y el aviso)
#   command-os-updates check    comprueba ahora y lo cuenta (clic derecho en la barra)
#   command-os-updates notify   notifica una vez cada versión nueva de command-os
#   command-os-updates watch    lo anterior cada 10 minutos (lo lanza el autostart de labwc)
set -uo pipefail
source /usr/lib/command-os/textos.sh

STATE=${COMMAND_OS_UPDATES_STATE:-/var/lib/command-os/updates}
PACMAN_LOCAL=${COMMAND_OS_PACMAN_LOCAL:-/var/lib/pacman/local}
# Flatpak lo toca tras cada instalación, actualización o desinstalación (también desde la tienda).
FLATPAK_CHANGED=${COMMAND_OS_FLATPAK_CHANGED:-/var/lib/flatpak/.changed}
NOTIFIED="${XDG_STATE_HOME:-${HOME}/.local/state}/command-os/updates-notified"
SIGNAL=8 # el mismo que "signal" del módulo en config.jsonc
TAG=command-os-updates

# Lee el estado en `comprobado` (segundos), `actual`/`nuevo` (versión de command-os instalada y
# disponible; `nuevo` vacío si no hay), `otros` (cuántos paquetes más), `lista` (una línea por
# paquete, sin command-os), `apps` (cuántas aplicaciones de la tienda), `lista_apps` (una línea por
# aplicación) y `filas_apps` (las líneas «app» tal cual, para el panel). Falla si no hay comprobación
# o es anterior al último cambio de pacman (algo se instaló después: lo que dice ya no vale). Si es
# anterior al último cambio de Flatpak, vale sin las aplicaciones.
leer() {
  comprobado=0 actual="" nuevo="" otros=0 lista="" apps=0 lista_apps="" filas_apps=""
  [[ -r "${STATE}" ]] || return 1
  comprobado=$(head -n 1 "${STATE}")
  [[ "${comprobado}" =~ ^[0-9]+$ ]] || return 1
  local instalado tocado
  instalado=$(stat -c %Y "${PACMAN_LOCAL}" 2>/dev/null || echo 0)
  (( comprobado >= instalado )) || return 1
  tocado=$(stat -c %Y "${FLATPAK_CHANGED}" 2>/dev/null || echo 0)
  local linea resto nombre antes _flecha despues
  while IFS= read -r linea; do
    if [[ "${linea}" == app$'\t'* ]]; then
      (( comprobado >= tocado )) || continue
      # Campos quizá vacíos: con IFS=$'\t' read juntaría los tabuladores seguidos.
      resto=${linea#app$'\t'} nombre=${resto%%$'\t'*}
      resto=${resto#*$'\t'} antes=${resto%%$'\t'*} despues=${resto#*$'\t'}
      [[ -n "${nombre}" ]] || continue
      apps=$((apps + 1))
      filas_apps+="${linea}"$'\n'
      if [[ -n "${antes}" && -n "${despues}" && "${antes}" != "${despues}" ]]; then
        lista_apps+="${nombre} ${antes} → ${despues}"$'\n'
      else
        lista_apps+="${nombre}${despues:+ ${despues}}"$'\n'
      fi
      continue
    fi
    read -r nombre antes _flecha despues <<< "${linea}"
    [[ -n "${nombre}" && -n "${despues}" ]] || continue
    if [[ "${nombre}" == command-os ]]; then
      actual=${antes%-*} nuevo=${despues%-*}
    else
      otros=$((otros + 1))
      lista+="${nombre} ${antes} → ${despues}"$'\n'
    fi
  done < <(tail -n +2 "${STATE}")
  return 0
}

# Hay algo que instalar (tras un `leer` que fue bien).
hay_algo() { [[ -n "${nuevo}" ]] || (( otros > 0 || apps > 0 )); }

# Hace cuánto, en palabras.
hace() {
  local s=$(( $(date +%s) - $1 ))
  if (( s < 90 )); then t 'hace un momento'
  elif (( s < 5400 )); then t 'hace %d min' $(( (s + 30) / 60 ))
  elif (( s < 172800 )); then t 'hace %d h' $(( (s + 1800) / 3600 ))
  else t 'hace %d días' $(( (s + 43200) / 86400 )); fi
}

# Escapa para el marcado de Pango (Waybar) y para una cadena JSON (los nombres y versiones de paquete
# no llevan comillas ni barras: se quitan por si acaso, \134 es la barra invertida).
pango() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }
json() { tr -d '"\134' | awk 'BEGIN { ORS = "" } NR > 1 { print "\134n" } { print }'; }

estado() {
  if ! leer || ! hay_algo; then
    printf '{"text": "", "tooltip": "", "class": "ninguna"}\n'
    return
  fi
  local total=$(( otros + apps + (${#nuevo} > 0 ? 1 : 0) )) clase=paquetes tip=""
  if [[ -n "${nuevo}" ]]; then
    clase=nueva
    tip="command-os ${actual} → ${nuevo}"$'\n'
    (( otros > 0 )) && tip+="$(tn 'y %d paquete más' 'y %d paquetes más' "${otros}" "${otros}")"$'\n'
    (( apps > 0 )) && tip+="$(tn 'y %d aplicación de la tienda' 'y %d aplicaciones de la tienda' "${apps}" "${apps}")"$'\n'
    if [[ "$(uname -m)" == x86_64 && ! -e /etc/command-os/rolling ]]; then
      tip+="$(t 'al actualizar se aplica también la fecha de Arch validada con esa versión')"$'\n'
    fi
  else
    if (( otros > 0 )); then
      tip="$(tn '%d paquete de Arch' '%d paquetes de Arch' "${otros}" "${otros}")"$'\n'
      tip+=$(printf '%s' "${lista}" | head -n 8)$'\n'
      (( otros > 8 )) && tip+="$(t '… y %d más' $(( otros - 8 )))"$'\n'
    fi
    if (( apps > 0 )); then
      (( otros > 0 )) && tip+=$'\n'
      tip+="$(tn '%d aplicación de la tienda' '%d aplicaciones de la tienda' "${apps}" "${apps}")"$'\n'
      tip+=$(printf '%s' "${lista_apps}" | head -n 8)$'\n'
      (( apps > 8 )) && tip+="$(t '… y %d más' $(( apps - 8 )))"$'\n'
    fi
  fi
  tip+=$'\n'"$(t 'comprobado %s · clic: ver y actualizar · clic derecho: comprobar ahora' "$(hace "${comprobado}")")"
  printf '{"text": "<span color=\\"#85827c\\">UPD</span> %s", "tooltip": "%s", "class": "%s"}\n' \
    "${total}" "$(printf '%s' "${tip}" | pango | json)" "${clase}"
}

# Lo que enseña el panel (lib/ajustes_actualizaciones.py), una cosa por línea y con tabuladores:
#   nada                                  no hay comprobación válida o no hay nada que instalar
#   hace<TAB>texto                        cuándo se comprobó, ya traducido
#   command-os<TAB>actual<TAB>nuevo       solo si hay versión nueva de command-os
#   arch<TAB>1|0                          si al actualizar se aplica una fecha nueva de Arch validada
#   paquete<TAB>nombre<TAB>antes<TAB>después   uno por cada paquete de Arch
#   app<TAB>nombre<TAB>antes<TAB>después       una por aplicación de la tienda (versiones quizá vacías)
# Con una comprobación que ya no vale (pacman cambió algo después) sale «nada», igual que la barra.
datos() {
  if ! leer || ! hay_algo; then
    # Si hay una comprobación válida pero sin novedades, el panel dice «al día» y cuándo se miró.
    if leer; then printf 'hace\t%s\n' "$(hace "${comprobado}")"; fi
    echo nada
    return
  fi
  printf 'hace\t%s\n' "$(hace "${comprobado}")"
  [[ -n "${nuevo}" ]] && printf 'command-os\t%s\t%s\n' "${actual}" "${nuevo}"
  local fecha=0
  [[ -n "${nuevo}" && "$(uname -m)" == x86_64 && ! -e /etc/command-os/rolling ]] && fecha=1
  printf 'arch\t%s\n' "${fecha}"
  local nombre antes _flecha despues
  while read -r nombre antes _flecha despues; do
    [[ -n "${nombre}" ]] && printf 'paquete\t%s\t%s\t%s\n' "${nombre}" "${antes}" "${despues}"
  done <<< "${lista}"
  printf '%s' "${filas_apps}"
}

# El panel gráfico: Ajustes → actualizaciones (lib/ajustes_actualizaciones.py).
panel() { exec command-os-ajustes actualizaciones; }

avisar() { # avisar <texto> [urgencia]; sustituye al aviso anterior de este programa
  notify-send --app-name "command os" --icon command-os --urgency "${2:-normal}" \
    --hint "string:x-canonical-private-synchronous:${TAG}" "$(t 'actualizaciones')" "$1" 2>/dev/null || true
}

actualizar() {
  if pgrep -u "$(id -u)" -f -- '--class command-os-update' >/dev/null; then
    avisar "$(t 'ya hay una actualización en marcha')"
    return
  fi
  # La terminal se queda abierta al terminar para leer el resultado; sudo pide la contraseña y
  # pacman pregunta antes de instalar: no cambia nada sin que se confirme.
  exec kitty --class command-os-update --title "$(t 'actualizar command os')" \
    sh -c 'command-os-update; rc=$?; echo; printf "%s " "$1"; read -r _; exit "$rc"' sh "$(t 'pulsa intro para cerrar')"
}

comprobar() {
  avisar "$(t 'buscando actualizaciones…')" low
  if systemctl start command-os-check-updates@manual.service 2>/dev/null; then
    pkill "-RTMIN+${SIGNAL}" -u "$(id -u)" -x waybar 2>/dev/null
    if leer && hay_algo; then
      avisar "$(t 'hay actualizaciones: clic en la barra para instalarlas')"
    else
      avisar "$(t 'el sistema está al día')"
    fi
  else
    avisar "$(t 'no se pudo comprobar (¿sin red?)')"
  fi
}

# Una vez por versión nueva de command-os (queda anotada en el estado de la cuenta). Solo ella: los
# paquetes sueltos de Arch no avisan, solo salen en la barra. Con --wait la llamada espera a que el
# aviso se cierre: el clic sobre él es la acción por defecto y abre la actualización.
notificar() {
  leer && [[ -n "${nuevo}" ]] || return 0
  [[ "$(cat "${NOTIFIED}" 2>/dev/null)" == "${nuevo}" ]] && return 0
  (
    respuesta=$(notify-send --app-name "command os" --icon command-os --urgency normal --wait \
      --action "default=$(t 'actualizar')" --hint "string:x-canonical-private-synchronous:${TAG}" \
      "$(t 'actualización disponible')" "$(t 'command-os %s · clic para actualizar' "${nuevo}")") || exit 0
    mkdir -p "$(dirname "${NOTIFIED}")" && printf '%s\n' "${nuevo}" > "${NOTIFIED}"
    [[ "${respuesta}" == default ]] && actualizar
  ) &
}

vigilar() {
  # Una sola instancia por sesión; el primer vistazo espera a que swaync y Waybar estén listos.
  exec 9> "${XDG_RUNTIME_DIR:-/tmp}/command-os-updates.lock"
  flock -n 9 || exit 0
  sleep 45
  while :; do
    notificar
    sleep 600
  done
}

case "${1:-}" in
  status) estado ;;
  update) actualizar ;;
  panel) panel ;;
  datos) datos ;;
  check) comprobar ;;
  notify) notificar; wait ;;
  watch) vigilar ;;
  *) echo "uso: command-os-updates <status|panel|datos|update|check|notify|watch>" >&2; exit 2 ;;
esac
