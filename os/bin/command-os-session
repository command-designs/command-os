#!/usr/bin/env bash
# Command OS — la sesión de escritorio (labwc). La lanza greetd al entrar, con contraseña o con
# inicio automático (/etc/command-os/greetd.toml). Vale para cualquier cuenta del equipo.
set -uo pipefail
source /usr/lib/command-os/entorno-grafico
export XDG_CURRENT_DESKTOP=labwc:wlroots XDG_SESSION_TYPE=wayland

# Cuenta lista antes de que labwc lea su configuración: la primera vez, tras una actualización, y
# los ajustes del equipo (teclado, perfil de VM) en ~/.config/labwc/environment.d/local.env.
command-os-user-setup >/dev/null 2>&1 || true

# El menú de labwc, traducido al idioma del equipo, en una carpeta de configuración propia que va
# la primera (lib/menus-labwc, docs/idioma.md). Sin ella, labwc no tendría menú.
if menus=$(/usr/lib/command-os/menus-labwc); then
  export XDG_CONFIG_DIRS="${menus}:${XDG_CONFIG_DIRS:-/etc/xdg}"
fi

# Aplicaciones de la tienda (Flatpak): sus .desktop e iconos, para el lanzador y las fijadas. Las
# carpetas las da el propio flatpak (/etc/profile.d/flatpak.sh), que greetd no carga: no es un shell
# de entrada. El script no está hecho para `set -u`.
export XDG_DATA_DIRS=${XDG_DATA_DIRS:-/usr/local/share:/usr/share}
if [[ -r /etc/profile.d/flatpak.sh ]]; then
  set +u
  source /etc/profile.d/flatpak.sh
  set -u
fi

# Herramientas técnicas fuera del lanzador: su sitio es Ajustes. Se copian sus .desktop con
# NoDisplay=true a una carpeta de ejecución que va la primera en XDG_DATA_DIRS (los originales son
# del sistema, los pisaría pacman). Lo que no esté instalado se salta.
apps="${XDG_RUNTIME_DIR:-}/command-os/xdg/applications"
if [[ -d "${XDG_RUNTIME_DIR:-}" && -O "${XDG_RUNTIME_DIR:-}" ]] && mkdir -p "${apps}"; then
  rm -f "${apps}"/*.desktop
  for d in lstopo nm-connection-editor network.cycles.wdisplays wdisplays btop blueman-manager \
           blueman-adapters pavucontrol avahi-discover bssh bvnc; do
    [[ -r "/usr/share/applications/${d}.desktop" ]] || continue
    awk '/^NoDisplay=/ { next } { print } /^\[Desktop Entry\]/ && !hecho { print "NoDisplay=true"; hecho = 1 }' \
      "/usr/share/applications/${d}.desktop" > "${apps}/${d}.desktop"
  done
  export XDG_DATA_DIRS="${apps%/applications}:${XDG_DATA_DIRS}"
fi

# --merge-config: la configuración de serie (/etc/xdg/labwc) más lo que el usuario añada en
# ~/.config/labwc. El registro va a un archivo, no a la pantalla.
exec labwc --merge-config > "${XDG_RUNTIME_DIR:-/tmp}/labwc.log" 2>&1
