#!/usr/bin/env bash
# Command OS — vuelve el sistema a una instantánea (raíz en btrfs con snapper).
#
#   command-os-rollback            si se ha arrancado una instantánea desde el menú de GRUB
#                                  (Esc al encender → instantáneas), la deja como sistema
#   command-os-rollback N          vuelve a la instantánea N (ver: snapper -c root list)
#   command-os-rollback --lista    lista las instantáneas
#
# Qué hace: guarda el sistema actual como @antes-de-volver-<fecha> (por si acaso), crea un @ nuevo a
# partir de la instantánea y pide reiniciar. /home no se toca: los archivos del usuario se quedan.
# Con el disco cifrado (/boot en una partición aparte), además pone en /boot el kernel de la instantánea.
set -euo pipefail

source /usr/lib/command-os/textos.sh
die() { echo "error: $*" >&2; exit 1; }
[[ "$(id -u)" -eq 0 ]] || exec sudo "$0" "$@"

[[ "${1:-}" == "--lista" ]] && exec snapper -c root list
mountpoint -q /.snapshots || die "$(t 'no hay instantáneas: la raíz no es btrfs con snapper')"

if [[ -n "${1:-}" ]]; then
  [[ "$1" =~ ^[0-9]+$ ]] || die "$(t 'uso: command-os-rollback [N | --lista]')"
  target="@snapshots/$1/snapshot"
else
  target=$(sed -nE 's/.*rootflags=subvol=\/?([^ ,]+).*/\1/p' /proc/cmdline)
  [[ "${target}" == @snapshots/*/snapshot ]] \
    || die "$(t 'no se ha arrancado una instantánea; indica el número (command-os-rollback --lista)')"
fi

dev=$(findmnt -nvo SOURCE /.snapshots)
top=$(mktemp -d /run/command-os-top.XXXX)
mount -o subvolid=5 "${dev}" "${top}"
trap 'umount "${top}"; rmdir "${top}"' EXIT
[[ -d "${top}/${target}" ]] || die "$(t 'no existe la instantánea %s' "${target}")"

old="@antes-de-volver-$(date +%Y%m%d-%H%M%S)"
echo "$(t 'Se va a volver a la instantánea %s.' "${target}")"
echo "$(t 'El sistema actual se guarda como %s y /home no se toca.' "${old}")"
if [[ "$(uname -m)" != x86_64 ]]; then
  echo "$(t 'Aviso: en la Raspberry Pi el kernel está fuera de la instantánea (partición de arranque);')"
  echo "$(t 'si se actualizó después, sus módulos no coincidirán hasta reinstalarlo.')"
fi
# La palabra de confirmación se escribe a mano: la de cada idioma (SI, YES…), tal como sale en el aviso.
palabra=$(t 'SI')
read -rp "$(t 'Escribe %s para continuar:' "${palabra}") " ok
[[ "${ok}" == "${palabra}" ]] || die "$(t 'cancelado')"

mv "${top}/@" "${top}/${old}"
btrfs subvolume snapshot "${top}/${target}" "${top}/@" >/dev/null

# Deshace el cambio de @ si algo falla a partir de aquí: el sistema queda como estaba.
undo() {
  echo "$(t 'error: %s; se deja el sistema como estaba' "$*")" >&2
  mv "${top}/@" "${top}/${old}-fallido" && mv "${top}/${old}" "${top}/@"
  btrfs subvolume delete "${top}/${old}-fallido" >/dev/null || true
  exit 1
}

# restore_kernel — con /boot en una partición aparte (disco cifrado: GRUB no lee la raíz), el kernel
# no entra en las instantáneas y el de /boot puede ser más nuevo que los módulos del sistema
# recuperado. Se pone el de la instantánea (Arch lo guarda junto a sus módulos, en
# /usr/lib/modules/<versión>/vmlinuz) y se rehace su initramfs con el mkinitcpio y la configuración
# del sistema recuperado. Primero se generan los archivos nuevos y solo al final se cambian. Solo los
# kernels de un paquete (no restos de una actualización a medias), y los que ya coinciden con el de
# /boot se dejan como están.
restore_kernel() {
  local new="${top}/@" m ver base f ok=1 nuevos=() vistos=" "
  local montajes=(dev proc sys boot)
  mount --bind /dev "${new}/dev" && mount -t proc proc "${new}/proc" && mount -t sysfs sys "${new}/sys" \
    && mount --bind /boot "${new}/boot" || ok=0
  if (( ok )); then
    for m in "${new}"/usr/lib/modules/*/; do
      [[ -f "${m}vmlinuz" && -f "${m}pkgbase" ]] || continue
      ver=$(basename "${m}") base=$(<"${m}pkgbase")
      chroot "${new}" pacman -Qqo "/usr/lib/modules/${ver}/vmlinuz" >/dev/null 2>&1 || continue
      if [[ "${vistos}" == *" ${base} "* ]]; then
        echo "$(t 'error: la instantánea tiene dos kernels %s' "${base}")" >&2
        ok=0
        break
      fi
      vistos+="${base} "
      if [[ -f "/boot/vmlinuz-${base}" && "$(sha256sum < "${m}vmlinuz")" == "$(sha256sum < "/boot/vmlinuz-${base}")" ]]; then
        echo "$(t 'Kernel %s %s: es el mismo que hay en /boot.' "${base}" "${ver}")"
        continue
      fi
      echo "$(t 'Kernel %s %s del sistema recuperado: rehaciendo su initramfs…' "${base}" "${ver}")"
      chroot "${new}" mkinitcpio -k "${ver}" -g "/boot/initramfs-${base}.img.nuevo" >/dev/null 2>&1 || { ok=0; break; }
      nuevos+=("/boot/initramfs-${base}.img")
      if [[ -f "/boot/initramfs-${base}-fallback.img" ]]; then
        chroot "${new}" mkinitcpio -k "${ver}" -S autodetect -g "/boot/initramfs-${base}-fallback.img.nuevo" \
          >/dev/null 2>&1 || { ok=0; break; }
        nuevos+=("/boot/initramfs-${base}-fallback.img")
      fi
      install -m 644 "${m}vmlinuz" "/boot/vmlinuz-${base}.nuevo" || { ok=0; break; }
      nuevos+=("/boot/vmlinuz-${base}")
    done
  fi
  for f in "${montajes[@]}"; do mountpoint -q "${new}/${f}" && umount "${new}/${f}"; done
  if (( ! ok )); then
    rm -f /boot/*.nuevo
    return 1
  fi
  for f in "${nuevos[@]}"; do mv "${f}.nuevo" "${f}" || return 1; done
  if [[ "${vistos}" == " " ]]; then
    echo "$(t 'aviso: la instantánea no tiene ningún kernel; se queda el de /boot')" >&2
  fi
  return 0
}

if mountpoint -q /boot && [[ -d /boot/grub ]]; then
  restore_kernel || undo "$(t 'no se pudo poner el kernel de la instantánea en /boot')"
else
  # /boot/grub va dentro de @ y la instantánea trae el suyo: desfasado (la lista de instantáneas del
  # menú es la de entonces), con módulos que pueden no casar con el GRUB de la partición EFI (esa no
  # vuelve atrás) o ni siquiera existir (las instantáneas de la imagen son de antes de instalar GRUB).
  # Se usa el del sistema anterior, que está al día: sus entradas no dependen de cuál sea el @. Si se
  # arrancó una instantánea, ese es ${old}; si ya se había vuelto atrás sin reiniciar, el que está en
  # marcha. Solo x86 (la Pi no tiene GRUB). Con /boot aparte, GRUB no está en @ y no hace falta.
  grub=""
  for g in "${top}/${old}/boot/grub" /boot/grub; do
    [[ -f "${g}/grub.cfg" ]] && { grub="${g}"; break; }
  done
  if [[ -n "${grub}" ]]; then
    rm -rf "${top}/@/boot/grub"
    cp -a "${grub}" "${top}/@/boot/grub"
  fi
fi
echo "$(t 'Hecho. Reinicia para entrar en el sistema recuperado.')"
echo "$(t 'Cuando todo funcione, puedes borrar la copia anterior con:')"
echo "  sudo mount -o subvolid=5 ${dev} /mnt && sudo btrfs subvolume delete -R /mnt/${old} && sudo umount /mnt"
