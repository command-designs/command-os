#!/usr/bin/env bash
# Command OS — cómo se entra al equipo al encenderlo.
#
#   command-os-login              muestra el modo actual
#   command-os-login auto [USER]  entra solo, sin pedir contraseña (por defecto, la cuenta principal)
#   command-os-login pedir        pide usuario y contraseña al encender (lo recomendado en un PC)
#
# Con inicio automático la sesión se sigue bloqueando con la contraseña (inactividad, Super+L, tapa).
# El cambio se aplica en el siguiente arranque.
set -euo pipefail

CONF=/etc/command-os
source /usr/lib/command-os/textos.sh
die() { echo "command-os-login: $*" >&2; exit 1; }

case "${1:-}" in
  "")
    if [[ -s "${CONF}/inicio-automatico" ]]; then
      echo "$(t 'al encender: entra solo como %s' "$(cat "${CONF}/inicio-automatico")")"
    else
      echo "$(t 'al encender: pide usuario y contraseña')"
    fi
    exit 0 ;;
  auto|pedir) ;;
  *) die "$(t 'uso: command-os-login [auto [usuario] | pedir]')" ;;
esac

[[ "$(id -u)" -eq 0 ]] || exec sudo "$0" "$@"

if [[ "$1" == auto ]]; then
  usuario=${2:-$(cat "${CONF}/cuenta-principal" 2>/dev/null || true)}
  [[ -n "${usuario}" ]] || die "$(t 'indica el usuario: command-os-login auto USUARIO')"
  getent passwd "${usuario}" >/dev/null || die "$(t 'no existe el usuario %s' "${usuario}")"
  IFS=: read -r _ _ uid _ _ _ shell < <(getent passwd "${usuario}")
  [[ "${uid}" -ge 1000 && "${uid}" -lt 60000 && "${shell}" != */nologin && "${shell}" != */false ]] \
    || die "$(t '%s no es una cuenta de persona' "${usuario}")"
  echo "${usuario}" > "${CONF}/inicio-automatico"
  echo "$(t 'hecho: al encender entrará solo como %s (la pantalla se sigue bloqueando con contraseña)' "${usuario}")"
else
  rm -f "${CONF}/inicio-automatico"
  echo "$(t 'hecho: al encender pedirá usuario y contraseña')"
fi
/usr/lib/command-os/apply-login
