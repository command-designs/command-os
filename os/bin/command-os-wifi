#!/usr/bin/env bash
# Command OS — elegir una red wi-fi en dos pasos: la red (con su señal, y un candado si pide
# contraseña) y, si hace falta, la contraseña. Clic derecho en la red de la barra o «wi-fi» en el panel
# de estado. Paneles wofi que se cierran al elegir: nada se queda en memoria (sustituye a nm-applet).
# Lo raro (redes ocultas, empresa, VPN) va en «ajustes de red avanzados» (nm-connection-editor).
# La contraseña llega a nmcli por la entrada estándar (--ask), nunca en la línea de órdenes, donde la
# vería cualquiera con ps. docs/notas/escritorio.md § «Barra».
set -uo pipefail
source /usr/lib/command-os/textos.sh

STYLE="$(command-os-config wofi/power.css)"
TAG="command-os-wifi"
ESPERA=30

# Si el panel ya está abierto, el segundo clic lo cierra.
if pkill -f "^wofi --dmenu --prompt ${TAG}" 2>/dev/null; then exit 0; fi

avisar() {  # avisar texto [urgencia]
  notify-send --app-name "command os" --icon network-wireless --urgency "${2:-low}" \
    --hint "string:x-canonical-private-synchronous:${TAG}" "$1" 2>/dev/null
}

menu() {  # menu línea…  -> imprime la línea elegida (Esc o clic fuera: nada)
  local n=$#
  (( n > 8 )) && n=8
  printf '%s\n' "$@" | wofi --dmenu --prompt "${TAG}" --style "${STYLE}" \
    --cache-file /dev/null --width 400 --lines "${n}" --location top_right --xoffset -24 --yoffset 8
}

# La contraseña, en el diálogo de los paneles (lib/clave-wifi.py): wofi no sirve para esto, porque con el
# campo enfocado GTK 3 no enseña el texto de ayuda y el panel no diría para qué red es.
contrasena() {  # contrasena red  -> imprime la contraseña escrita (cancelar: nada y falla)
  GTK_THEME=${GTK_THEME:-adw-gtk3:dark} PYTHONPATH=/usr/lib/command-os \
    "${COMMAND_OS_CLAVE_WIFI:-/usr/lib/command-os/clave-wifi.py}" "$1" 2>/dev/null
}

dispositivo=$(nmcli -t -e no -f DEVICE,TYPE device 2>/dev/null | awk -F: '$2 == "wifi" { print $1; exit }')
if [[ -z "${dispositivo}" ]]; then
  avisar "$(t 'este equipo no tiene wi-fi')"
  exit 0
fi

if [[ "$(nmcli radio wifi 2>/dev/null)" != enabled ]]; then
  ENCENDER="󰖩   $(t 'encender el wi-fi')"
  [[ "$(menu "${ENCENDER}")" == "${ENCENDER}" ]] || exit 0
  nmcli radio wifi on || exit 0
  avisar "$(t 'buscando redes…')"
  sleep 3
fi

# Redes: la conectada primero y luego de más a menos señal, una vez cada nombre (varios puntos de
# acceso de la misma red salen juntos) y sin las ocultas. El nombre es el último campo y puede llevar
# «:»: read deja el resto entero en la última variable.
lineas=() redes=() seguras=()
declare -A vista=()
actual=""
while IFS=: read -r uso senal seg ssid; do
  [[ -z "${ssid}" || -n "${vista[${ssid}]:-}" ]] && continue
  vista[${ssid}]=1
  [[ "${senal}" =~ ^[0-9]+$ ]] || senal=0
  if (( senal >= 80 )); then icono="󰤨"; elif (( senal >= 60 )); then icono="󰤥"
  elif (( senal >= 40 )); then icono="󰤢"; elif (( senal >= 20 )); then icono="󰤟"; else icono="󰤯"; fi
  segura=""
  [[ -n "${seg}" && "${seg}" != "--" ]] && segura=1
  if [[ "${uso}" == "*" ]]; then
    actual=${ssid}
    lineas+=("${icono}   $(t '%s · conectada' "${ssid}")")
  else
    lineas+=("${icono}   ${ssid}${segura:+   󰌾}")
  fi
  redes+=("${ssid}")
  seguras+=("${segura}")
done < <(nmcli -t -e no -f IN-USE,SIGNAL,SECURITY,SSID device wifi list --rescan auto 2>/dev/null \
  | sort -t: -k1,1r -k2,2nr)

if (( ${#lineas[@]} == 0 )); then
  avisar "$(t 'no se ve ninguna red wi-fi')"
  exit 0
fi

eleccion=$(menu "${lineas[@]}") || exit 0
i=-1
for n in "${!lineas[@]}"; do
  [[ "${lineas[n]}" == "${eleccion}" ]] && { i=${n}; break; }
done
(( i >= 0 )) || exit 0
red=${redes[i]}

# La conectada: desconectar (con confirmación, como el menú de energía).
if [[ "${red}" == "${actual}" ]]; then
  DESCONECTAR="󰖪   $(t 'desconectar de %s' "${red}")"
  CANCELAR="󰜺   $(t 'cancelar')"
  [[ "$(menu "${DESCONECTAR}" "${CANCELAR}")" == "${DESCONECTAR}" ]] && nmcli device disconnect "${dispositivo}" >/dev/null
  exit 0
fi

avisar "$(t 'conectando a %s…' "${red}")"
# Una red ya guardada (nmcli y nm-applet le ponen su nombre) entra sin preguntar; si su contraseña ya
# no vale, se pide otra. Una nueva: abierta, directa; con contraseña, se pide antes.
if nmcli -t -e no -f NAME connection show 2>/dev/null | grep -qxF -- "${red}"; then
  if nmcli --wait "${ESPERA}" connection up id "${red}" >/dev/null 2>&1; then
    ok=1
  elif [[ -n "${seguras[i]}" ]] && pw=$(contrasena "${red}"); then
    printf '%s\n' "${pw}" | nmcli --ask --wait "${ESPERA}" connection up id "${red}" >/dev/null 2>&1 && ok=1
  fi
elif [[ -z "${seguras[i]}" ]]; then
  nmcli --wait "${ESPERA}" device wifi connect "${red}" ifname "${dispositivo}" >/dev/null 2>&1 && ok=1
elif pw=$(contrasena "${red}"); then
  printf '%s\n' "${pw}" | nmcli --ask --wait "${ESPERA}" device wifi connect "${red}" ifname "${dispositivo}" >/dev/null 2>&1 && ok=1
else
  exit 0
fi
unset pw

if [[ -n "${ok:-}" ]]; then
  avisar "$(t 'conectada a %s' "${red}")"
else
  avisar "$(t 'no se pudo conectar a %s' "${red}")" normal
fi
exit 0
