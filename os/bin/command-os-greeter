#!/usr/bin/env bash
# Command OS — pantalla de inicio de sesión (lib/greeter.py) a pantalla completa dentro de cage. La
# ejecuta greetd como el usuario greeter (/etc/command-os/greetd.toml, lib/apply-login).
set -uo pipefail
source /usr/lib/command-os/entorno-grafico
export GTK_THEME=adw-gtk3:dark
# Antes de abrir la ventana, la escala de la pantalla (alta densidad, command-os-pantallas).
exec cage -s -d -- sh -c 'command-os-pantallas aplicar; command-os-pantallas vigilar &
exec python3 /usr/lib/command-os/greeter.py'
