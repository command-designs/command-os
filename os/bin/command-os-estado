#!/usr/bin/env bash
# Command OS — panel de estado (clic en el grupo de estado de la barra): red, Bluetooth, sonido y
# batería, cada uno con lo suyo, y enseñar u ocultar la telemetría. Panel wofi como el menú de
# energía, bajo la barra a la derecha: se abre al usarlo y no se queda en memoria. Lo sustituirá el
# centro de control (ROADMAP.md, punto 5). docs/notas/escritorio.md § «Barra».
set -uo pipefail
source /usr/lib/command-os/textos.sh

STYLE="$(command-os-config wofi/power.css)"
TAG="command-os-estado"

# Si el panel ya está abierto, el segundo clic lo cierra.
if pkill -f "^wofi --dmenu --prompt ${TAG}" 2>/dev/null; then exit 0; fi

# La red de verdad (wifi o cable) conectada: «tipo:nombre». El nombre es el último campo y puede
# llevar «:», así que se quita lo de delante en vez de partir por «:».
red=$(nmcli -t -e no -f TYPE,STATE,CONNECTION device 2>/dev/null \
  | awk '/^(wifi|ethernet):connected:/ { print; exit }')
case "${red}" in
  wifi:*) RED="󰖩   $(t 'wi-fi · %s' "${red#wifi:connected:}")" ;;
  ethernet:*) RED="󰈀   $(t 'red · por cable')" ;;
  *) RED="󰖪   $(t 'wi-fi · sin red')" ;;
esac

# Bluetooth, solo con adaptador (como en la barra). Se mira antes en /sys: sin adaptador, bluetoothctl
# show se queda esperando a que aparezca uno.
BT=""
if compgen -G "${COMMAND_OS_BLUETOOTH_SYS:-/sys/class/bluetooth}/hci*" >/dev/null \
    && bt=$(timeout 3 bluetoothctl show 2>/dev/null) && [[ "${bt}" == *Powered:* ]]; then
  if [[ "${bt}" == *"Powered: yes"* ]]; then BT="󰂯   $(t 'bluetooth · encendido')"; else BT="󰂲   $(t 'bluetooth · apagado')"; fi
fi

if [[ "$(pamixer --get-mute 2>/dev/null)" == true ]]; then
  SONIDO="󰖁   $(t 'sonido · silenciado')"
else
  SONIDO="󰕾   $(t 'sonido · %s %%' "$(pamixer --get-volume 2>/dev/null || echo 0)")"
fi

# Batería, solo si hay (lib/bateria.py, lo mismo que los avisos).
BAT=""
capacidad=$(PYTHONPATH=/usr/lib/command-os python3 -c \
  'import bateria; d = bateria.estado(); print(d["capacidad"] if d else "")' 2>/dev/null)
[[ -n "${capacidad}" ]] && BAT="󰁹   $(t 'batería · %s %%' "${capacidad}")"

if [[ "$(command-os-fijadas telemetria 2>/dev/null)" == si ]]; then
  TELEMETRIA="󰍛   $(t 'ocultar cpu, temperatura y memoria')"
else
  TELEMETRIA="󰍛   $(t 'mostrar cpu, temperatura y memoria')"
fi
AVANZADO="󰒓   $(t 'ajustes de red avanzados')"

opciones=("${RED}")
[[ -n "${BT}" ]] && opciones+=("${BT}")
opciones+=("${SONIDO}")
[[ -n "${BAT}" ]] && opciones+=("${BAT}")
opciones+=("${TELEMETRIA}" "${AVANZADO}")

choice=$(printf '%s\n' "${opciones[@]}" | wofi --dmenu --prompt "${TAG}" --style "${STYLE}" \
  --cache-file /dev/null --width 400 --lines ${#opciones[@]} --location top_right --xoffset -24 --yoffset 8) || exit 0

case "${choice}" in
  "${RED}") exec command-os-wifi ;;
  "${SONIDO}") exec command-os-volume ;;
  "${TELEMETRIA}") exec command-os-fijadas telemetria cambiar >/dev/null ;;
  "${AVANZADO}") exec nm-connection-editor ;;
  "") exit 0 ;;
  "${BT}") exec command-os-bluetooth panel ;;
  "${BAT}") exec command-os-bateria panel ;;
esac
exit 0
