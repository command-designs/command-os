// Command OS — fastfetch (información del sistema). Se instala en /etc/xdg/fastfetch/ para todos
// los usuarios; cada uno puede sustituirla con ~/.config/fastfetch/config.jsonc.
// Logo: la C de Command con su barra (build/make-fastfetch-logo.py). Paleta de docs/DISENO.md:
// claves en cian (dato), separador rojo, valores en hueso. Voz de la marca: minúsculas.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/command-os/fastfetch/command-logo.txt",
        "color": {
            "1": "#EDEBE6",
            "2": "#A51500"
        },
        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        }
    },
    "display": {
        "separator": " › ",
        "color": {
            "keys": "#5BBFC4",
            "title": "#EDEBE6",
            "output": "#EDEBE6",
            "separator": "#D13449"
        },
        // El ancho incluye el separador: "escritorio › " son 13.
        "key": {
            "width": 14
        },
        // Porcentajes (memoria, disco, batería): cian normal, ámbar aviso, rojo crítico.
        "percent": {
            "color": {
                "green": "#5BBFC4",
                "yellow": "#E2C044",
                "red": "#D13449"
            }
        },
        "brightColor": false
    },
    "modules": [
        {
            "type": "title",
            "color": {
                "user": "#EDEBE6",
                "at": "#6F6870",
                "host": "#D13449"
            }
        },
        {
            "type": "separator",
            "string": "─",
            "outputColor": "#2E2630"
        },
        { "type": "os", "key": "sistema", "format": "{pretty-name} · {arch}" },
        { "type": "host", "key": "equipo" },
        { "type": "kernel", "key": "kernel" },
        { "type": "uptime", "key": "encendido" },
        { "type": "packages", "key": "paquetes" },
        { "type": "wm", "key": "escritorio" },
        { "type": "display", "key": "pantalla" },
        { "type": "terminal", "key": "terminal" },
        { "type": "shell", "key": "shell" },
        "break",
        { "type": "cpu", "key": "cpu" },
        { "type": "gpu", "key": "gpu" },
        { "type": "memory", "key": "memoria" },
        { "type": "disk", "key": "disco", "folders": "/" },
        { "type": "battery", "key": "batería" },
        { "type": "localip", "key": "red" }
    ]
}
