# Command — tema de ventanas de Command OS para labwc (labwc-theme(5)).
# Marca v2 de Command (docs/DISENO.md): casi monocromo, esquinas vivas, el rojo como señal (Red Hot
# en el filo de la ventana activa y en el foco), sin halos ni transparencias.
# Void #0E0E0E · Graphite #151515 · Slate #1F1F1F · Steel #2A2A2A · Bone #EDEBE6
# Ash #A3A09A · Smoke #85827C · Signal Red #A51500 · Red Hot #F5482C · Warn #FFB020
# Botones: SVG de build/make-labwc-buttons.py (mismo directorio). Fuentes y radio 0: rc.xml.

# --- Marco ---
# Ventana activa: filo Red Hot de 1 px. Las dos llevan una sombra oscura corta para que las ventanas
# flotantes se separen del fondo (sin halo rojo: el halo es solo de la barra del logo).
border.width: 1
window.active.border.color: #f5482c
window.inactive.border.color: #2a2a2a
window.active.indicator.toggled-keybind.color: #ffb020

window.active.shadow.size: 12
window.active.shadow.color: #00000099
window.inactive.shadow.size: 12
window.inactive.shadow.color: #00000070

# --- Barra de título ---
window.titlebar.padding.width: 4
window.titlebar.padding.height: 0
window.active.title.bg: Solid
window.active.title.bg.color: #1f1f1f
window.inactive.title.bg: Solid
window.inactive.title.bg.color: #0e0e0e
window.active.label.text.color: #edebe6
window.inactive.label.text.color: #85827c
window.label.text.justify: Left

window.button.width: 30
window.button.height: 26
window.button.spacing: 0
window.button.hover.bg.color: #2a2a2a
window.button.hover.bg.corner-radius: 0
# Solo aplican a los botones sin SVG propio (menu, shade, desk).
window.active.button.unpressed.image.color: #a3a09a
window.inactive.button.unpressed.image.color: #85827c

# --- Menús (escritorio, ventana) ---
menu.border.width: 1
menu.border.color: #2a2a2a
menu.overlap.x: 0
menu.overlap.y: 0
menu.width.min: 210
menu.width.max: 320
menu.items.padding.x: 12
menu.items.padding.y: 6
menu.items.bg.color: #151515
menu.items.text.color: #edebe6
menu.items.active.bg.color: #1f1f1f
menu.items.active.text.color: #f5482c
menu.separator.width: 1
menu.separator.padding.width: 8
menu.separator.padding.height: 4
menu.separator.color: #2a2a2a
# Rótulos de sección: Smoke sobre Void, como las etiquetas de la barra.
menu.title.bg.color: #0e0e0e
menu.title.text.color: #85827c
menu.title.text.justify: Left

# --- OSD: selector de ventanas (Alt+Tab) y de espacios de trabajo ---
osd.bg.color: #151515
osd.border.color: #2a2a2a
osd.border.width: 1
osd.label.text.color: #edebe6
osd.window-switcher.style-classic.width: 560
osd.window-switcher.style-classic.padding: 6
osd.window-switcher.style-classic.item.padding.x: 10
osd.window-switcher.style-classic.item.padding.y: 5
osd.window-switcher.style-classic.item.active.border.width: 1
osd.window-switcher.style-classic.item.active.border.color: #f5482c
osd.window-switcher.style-classic.item.active.bg.color: #1a1311
osd.window-switcher.style-classic.item.icon.size: 20
# Contorno de la ventana elegida en el selector: Red Hot entre dos líneas Void.
osd.window-switcher.preview.border.width: 2
osd.window-switcher.preview.border.color: #0e0e0e,#f5482c,#0e0e0e
osd.workspace-switcher.boxes.width: 18
osd.workspace-switcher.boxes.height: 12
osd.workspace-switcher.boxes.border.width: 1

# --- Guías al encajar ventanas en bordes y regiones ---
snapping.overlay.region.bg.enabled: yes
snapping.overlay.edge.bg.enabled: yes
snapping.overlay.region.border.enabled: yes
snapping.overlay.edge.border.enabled: yes
snapping.overlay.region.bg.color: #edebe614
snapping.overlay.edge.bg.color: #edebe614
snapping.overlay.region.border.width: 1
snapping.overlay.edge.border.width: 1
snapping.overlay.region.border.color: #f5482c
snapping.overlay.edge.border.color: #f5482c

magnifier.border.width: 1
magnifier.border.color: #2a2a2a
