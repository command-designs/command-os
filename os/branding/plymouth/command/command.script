# Command OS — firma de arranque (BRAND.md § 12.1, ancla 2), versión para clientes.
#
# El wordmark animado (28 fotogramas a 2 ticks cada uno, ~1,1 s a 50 Hz; se queda en el último),
# una barra de progreso fina debajo y, bajo la barra, una consola de 6 líneas con los servicios que
# va arrancando systemd (llegan por Plymouth.SetUpdateStatusFunction / SetMessageFunction). Es el
# único texto del arranque: el cargador, el kernel y systemd no escriben en pantalla.
# Cualquier tecla salta la animación del wordmark (va al último fotograma; el arranque no se toca).
# Para soporte técnico, Esc cambia al modo detalles de Plymouth (texto de arranque completo).
# Con el disco cifrado, la contraseña se pide aquí mismo, en el sitio de la consola (abajo).
# El progreso lo calcula Plymouth con la duración guardada de arranques anteriores; en el
# primer arranque es una estimación por defecto. Al apagar/reiniciar no hay barra.
# Paleta HUD (docs/DISENO.md): fondo Void #0D0B0E, barra roja sobre Steel.
Window.SetBackgroundTopColor(0.051, 0.043, 0.055);
Window.SetBackgroundBottomColor(0.051, 0.043, 0.055);

# Todo va en proporción al alto de la pantalla: igual de grande en 1366x768 que en 2560x1600 o
# en 4K. A 1080 px de alto, K = 1 (wordmark de 640 px). Los fotogramas vienen a doble resolución
# (build/make-plymouth.py) y se reducen una sola vez aquí, al cargarlos.
K = Window.GetHeight() / 1080;
if (K < 0.7) K = 0.7;
if (K > 2) K = 2;
SRC = 2;  # resolución de los fotogramas
BAR_H = Math.Int(2 * K + 0.5);
if (BAR_H < 2) BAR_H = 2;
PAD = Math.Int(16 * K);  # margen transparente de los fotogramas (halo y glitch)

frame_count = 28;
for (i = 0; i < frame_count; i++) {
    src = Image("frame-" + i + ".png");
    frame[i] = src.Scale(Math.Int(src.GetWidth() * K / SRC), Math.Int(src.GetHeight() * K / SRC));
}

# --- Composición: wordmark centrado, barra a la mitad de su ancho, centrada debajo ---
logo_w = frame[0].GetWidth() - 2 * PAD;
logo_x = Window.GetX() + (Window.GetWidth() - logo_w) / 2;
logo_y = Window.GetY() + (Window.GetHeight() - frame[0].GetHeight()) / 2 - Math.Int(20 * K);
bar_w  = Math.Int(logo_w / 2);
bar_x  = Window.GetX() + (Window.GetWidth() - bar_w) / 2;
bar_y  = logo_y + frame[0].GetHeight() - PAD + Math.Int(56 * K);

logo = Sprite();
logo.SetX(logo_x - PAD);
logo.SetY(logo_y);
logo.SetImage(frame[0]);

# --- Barra de progreso (dos píxeles escalados: fondo tenue + relleno rojo) --------
px_dim = Image("px-dim.png");
px_red = Image("px-red.png");
bar_bg = Sprite(px_dim.Scale(bar_w, BAR_H));
bar_bg.SetPosition(bar_x, bar_y, 1);
bar_fg = Sprite();
bar_fg.SetPosition(bar_x, bar_y, 2);
bar_px = 0;

booting = (Plymouth.GetMode() == "boot");
if (!booting) bar_bg.SetOpacity(0);

# --- Consola de arranque: bajo la barra, alineada con el wordmark ---------------------
# La línea más reciente (abajo) en hueso; las anteriores se apagan hacia Smoke. Solo al arrancar.
FONT = "Monospace " + Math.Int(9 * K + 0.5);
LOG_LINES = 6;
LINE_H = Math.Int(17 * K + 0.5);
LOG_MAX = 76;
log_y = bar_y + BAR_H + Math.Int(28 * K);
for (i = 0; i < LOG_LINES; i++) {
    log_text[i] = "";
    log_sprite[i] = Sprite();
    log_sprite[i].SetPosition(logo_x, log_y + i * LINE_H, 3);
}

fun draw_log() {
    for (i = 0; i < LOG_LINES; i++) {
        if (log_text[i] == "") {
            log_sprite[i].SetOpacity(0);
        } else {
            t = (i + 1) / LOG_LINES;
            if (i == LOG_LINES - 1) {
                log_sprite[i].SetImage(Image.Text(log_text[i], 0.93, 0.92, 0.90, 1, FONT));
            } else {
                # Smoke #6F6870 -> Ash #A8A2A6
                log_sprite[i].SetImage(Image.Text(log_text[i], 0.30 + 0.36 * t, 0.28 + 0.36 * t, 0.30 + 0.35 * t, 1, FONT));
            }
            log_sprite[i].SetOpacity(1);
        }
    }
}

fun push_line(msg) {
    if (!booting) return;
    if (msg == "") return;
    if (msg.Length() > LOG_MAX) msg = msg.SubString(0, LOG_MAX);
    for (i = 0; i < LOG_LINES - 1; i++)
        log_text[i] = log_text[i + 1];
    log_text[LOG_LINES - 1] = "> " + msg;
    draw_log();
}

Plymouth.SetMessageFunction(push_line);
Plymouth.SetUpdateStatusFunction(push_line);
push_line("cmd-os: iniciando sistema");

fun boot_progress_callback(time, progress) {
    if (!booting) return;
    if (progress > 1) progress = 1;
    if (progress < 0) progress = 0;
    # Solo se reescala cuando cambia de píxel.
    w = Math.Int(bar_w * progress);
    if (w != bar_px) {
        bar_px = w;
        if (w > 0) {
            bar_fg.SetImage(px_red.Scale(w, BAR_H));
            bar_fg.SetOpacity(1);
        }
    }
}
Plymouth.SetBootProgressFunction(boot_progress_callback);

# --- Animación del wordmark -------------------------------------------------------
tick = 0;
fun refresh_callback() {
    idx = Math.Int(tick / 2);
    if (idx >= frame_count) idx = frame_count - 1;
    logo.SetImage(frame[idx]);
    tick++;
}
Plymouth.SetRefreshFunction(refresh_callback);

# --- Saltar la animación con una tecla ---------------------------------------------
fun key_callback(key) {
    if (tick < frame_count * 2) tick = frame_count * 2;
}
Plymouth.SetKeyboardInputFunction(key_callback);

# --- Contraseña del disco cifrado ---------------------------------------------------
# La pide el gancho command-os-cifrado del initramfs (os/initcpio). En el sitio de la consola: el
# texto, una línea de campo y un cuadradito hueso por carácter (no se ve cuántos hay a partir de
# DOT_MAX) con el cursor cian detrás. Los dos textos del gancho van como imágenes en JetBrains Mono
# (build/make-plymouth-textos.py): en el initramfs, Image.Text pinta la ñ y las tildes como cuadrados.
# Se reconocen por su contenido («incorrecta», «del disco»); cualquier otro, con Image.Text.
px_bone = Image("px-bone.png");
px_cyan = Image("px-cyan.png");
src = Image("texto-clave.png");
img_prompt = src.Scale(Math.Int(src.GetWidth() * K / SRC), Math.Int(src.GetHeight() * K / SRC));
src = Image("texto-clave-mala.png");
img_wrong = src.Scale(Math.Int(src.GetWidth() * K / SRC), Math.Int(src.GetHeight() * K / SRC));
DOT = Math.Int(7 * K + 0.5);
DOT_GAP = DOT;
DOT_MAX = Math.Int(logo_w / (DOT + DOT_GAP)) - 2;
field_y = log_y + Math.Int(LINE_H * 1.8);
prompt_sprite = Sprite();
prompt_sprite.SetPosition(logo_x, log_y, 4);
field_line = Sprite(px_dim.Scale(logo_w, BAR_H));
field_line.SetPosition(logo_x, field_y + DOT + Math.Int(10 * K), 4);
field_line.SetOpacity(0);
caret = Sprite(px_cyan.Scale(Math.Int(DOT / 2) + 1, DOT + Math.Int(6 * K)));
caret.SetOpacity(0);
for (i = 0; i < DOT_MAX; i++) {
    dot[i] = Sprite(px_bone.Scale(DOT, DOT));
    dot[i].SetPosition(logo_x + i * (DOT + DOT_GAP), field_y, 4);
    dot[i].SetOpacity(0);
}

fun show_log(visible) {
    for (i = 0; i < LOG_LINES; i++) {
        if (visible && log_text[i] != "") log_sprite[i].SetOpacity(1);
        else log_sprite[i].SetOpacity(0);
    }
}

fun contains(text, word) {
    for (i = 0; i + word.Length() <= text.Length(); i++)
        if (text.SubString(i, i + word.Length()) == word) return 1;
    return 0;
}

fun display_password_callback(prompt, bullets) {
    show_log(0);
    if (contains(prompt, "incorrecta")) {
        prompt_sprite.SetImage(img_wrong);
    } else if (prompt == "" || contains(prompt, "del disco")) {
        prompt_sprite.SetImage(img_prompt);
    } else {
        if (prompt.Length() > LOG_MAX) prompt = prompt.SubString(0, LOG_MAX);
        prompt_sprite.SetImage(Image.Text(prompt, 0.93, 0.92, 0.90, 1, FONT));
    }
    prompt_sprite.SetOpacity(1);
    field_line.SetOpacity(1);
    shown = bullets;
    if (shown > DOT_MAX) shown = DOT_MAX;
    for (i = 0; i < DOT_MAX; i++) {
        if (i < shown) dot[i].SetOpacity(1);
        else dot[i].SetOpacity(0);
    }
    caret.SetPosition(logo_x + shown * (DOT + DOT_GAP), field_y - Math.Int(3 * K), 5);
    caret.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    prompt_sprite.SetOpacity(0);
    field_line.SetOpacity(0);
    caret.SetOpacity(0);
    for (i = 0; i < DOT_MAX; i++) dot[i].SetOpacity(0);
    show_log(1);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);
