#!/usr/bin/env bash
# Command OS — crea la cuenta principal del equipo. Lo usa el asistente de primer arranque
# (command-os-primer-arranque) y, en las imágenes de desarrollo, install.sh. Solo root.
#
#   crear-cuenta --usuario NOMBRE [--nombre "Nombre completo"] [--teclado es] [--idioma es_ES.UTF-8]
#                [--zona Europe/Madrid] [--inicio-auto]
#
# La contraseña llega por la entrada estándar (una línea), nunca como argumento ni variable: así
# no queda en la lista de procesos, en el historial ni en ningún registro. Se guarda solo como
# hash (yescrypt) en /etc/shadow; Command OS no la ve ni la envía a ningún sitio.
#
# La cuenta es la administradora del equipo (grupo wheel: sudo con su propia contraseña) y root
# queda bloqueado: toda la administración pasa por sudo. Si algo falla, no queda nada a medias.
# La zona horaria (command-os-zona-horaria) y el idioma (command-os-idioma) se aplican después de
# crear la cuenta; si algo falla, se deshace todo, zona incluida. Los mensajes salen en el idioma de
# LANG (el asistente lo pone con el idioma elegido).
set -uo pipefail

ESTADO=/var/lib/command-os
CONF=/etc/command-os
# shellcheck source=reglas.sh
source "$(dirname "${BASH_SOURCE[0]}")/reglas.sh"

export TEXTDOMAIN=command-os TEXTDOMAINDIR=/usr/share/locale
# t 'texto con %s' ARGS… — el texto traducido (os/po/, docs/idioma.md) o, sin traducción, el original.
t() {
  local f=$1 traducido
  shift
  traducido=$(gettext -- "${f}" 2>/dev/null) && f=${traducido}
  # shellcheck disable=SC2059  # el formato es el texto traducido
  printf -- "${f}" "$@"
}
die() { echo "crear-cuenta: $*" >&2; exit 1; }
[[ "$(id -u)" -eq 0 ]] || die "$(t 'hay que ejecutarlo como root')"

usuario="" nombre="" teclado="" idioma="" zona="" auto=0
while (( $# )); do
  case "$1" in
    --usuario) usuario=${2:-}; shift 2 ;;
    --nombre) nombre=${2:-}; shift 2 ;;
    --teclado) teclado=${2:-}; shift 2 ;;
    --idioma) idioma=${2:-}; shift 2 ;;
    --zona) zona=${2:-}; shift 2 ;;
    --inicio-auto) auto=1; shift ;;
    *) die "$(t 'opción desconocida: %s' "$1")" ;;
  esac
done

[[ -e "${ESTADO}/configurado" ]] && die "$(t 'el equipo ya está configurado')"
usuario_valido "${usuario}" \
  || die "$(t 'nombre de usuario no válido: minúsculas, números, - o _, empezando por una letra')"
getent passwd "${usuario}" >/dev/null && die "$(t 'ya existe un usuario llamado %s' "${usuario}")"
getent group "${usuario}" >/dev/null && die "$(t '%s es un nombre reservado del sistema: elige otro' "${usuario}")"
[[ "${nombre}" != *:* && "${nombre}" != *$'\n'* ]] || die "$(t "el nombre completo no puede llevar ':'")"
if [[ -n "${teclado}" ]]; then
  # Distribución de xkb, con variante opcional: es, latam, us-intl, de(nodeadkeys)…
  [[ "${teclado}" =~ ^[a-z][a-z0-9_-]{1,15}(\([a-z0-9_-]+\))?$ ]] || die "$(t 'distribución de teclado no válida')"
fi
# Solo un idioma de la lista de command-os-idioma, escrito tal cual (es_ES.UTF-8).
if [[ -n "${idioma}" ]] && ! command-os-idioma lista | cut -d' ' -f1 | grep -qxF -- "${idioma}"; then
  die "$(t 'idioma no disponible: %s' "${idioma}")"
fi
# Solo una zona de la lista de command-os-zona-horaria (zone.tab y UTC), escrita tal cual.
if [[ -n "${zona}" ]]; then
  zonas=$(command-os-zona-horaria lista)
  grep -qxF -- "${zona}" <<< "${zonas}" || die "$(t 'zona horaria no disponible: %s' "${zona}")"
fi

IFS= read -r contrasena || true
! contrasena_corta "${contrasena}" \
  || die "$(t 'la contraseña tiene que tener al menos %s caracteres' "${MIN_CONTRASENA}")"

zona_antes=""
deshacer() {
  # La zona de antes, con la misma orden: si el reloj del equipo va en hora local, lo vuelve a leer
  # con ella y la hora del sistema queda como estaba.
  if [[ -n "${zona_antes}" ]]; then
    command-os-zona-horaria "${zona_antes}" >/dev/null 2>&1 \
      || echo "crear-cuenta: aviso: no se pudo volver a la zona horaria ${zona_antes}" >&2
  fi
  userdel -r "${usuario}" >/dev/null 2>&1
  die "$1"
}
useradd -m -G wheel -s /bin/bash -c "${nombre}" "${usuario}" || die "$(t 'no se pudo crear la cuenta')"
printf '%s:%s\n' "${usuario}" "${contrasena}" | chpasswd || deshacer "$(t 'no se pudo fijar la contraseña')"
unset contrasena

# Zona horaria (con el reloj del equipo en hora local, se vuelve a leer con la zona nueva).
if [[ -n "${zona}" ]]; then
  # Por su nombre (UTC si no había ninguna); vacío si no se sabe (/etc/localtime copiado): entonces no
  # hay a qué volver.
  antes=$(command-os-zona-horaria actual)
  command-os-zona-horaria "${zona}" >/dev/null || deshacer "$(t 'no se pudo aplicar la zona horaria %s' "${zona}")"
  zona_antes=${antes}
fi

# Idioma del sistema y menú de arranque en ese idioma (unos segundos: rehace GRUB).
if [[ -n "${idioma}" ]]; then
  command-os-idioma "${idioma}" >/dev/null || deshacer "$(t 'no se pudo aplicar el idioma %s' "${idioma}")"
fi

# root sin contraseña ni acceso: se administra con sudo (cuenta de wheel).
passwd -l root >/dev/null 2>&1 || true

if [[ -n "${teclado}" ]]; then
  install -d "${CONF}"
  echo "${teclado}" > "${CONF}/kb_layout"
  # Consola (tty2 de emergencia): el mapa equivalente, si existe (los nombres no coinciden con xkb).
  case "${teclado}" in
    gb) mapa=uk ;; latam) mapa=la-latin1 ;; br) mapa=br-abnt2 ;; pt) mapa=pt-latin1 ;; *) mapa=${teclado%%(*} ;;
  esac
  if [[ -n "$(find /usr/share/kbd/keymaps -name "${mapa}.map.gz" -print -quit 2>/dev/null)" ]]; then
    touch /etc/vconsole.conf
    sed -i '/^KEYMAP=/d' /etc/vconsole.conf
    echo "KEYMAP=${mapa}" >> /etc/vconsole.conf
  fi
fi

install -d "${CONF}" "${ESTADO}"
echo "${usuario}" > "${CONF}/cuenta-principal"
if (( auto )); then echo "${usuario}" > "${CONF}/inicio-automatico"; else rm -f "${CONF}/inicio-automatico"; fi
touch "${ESTADO}/configurado"
/usr/lib/command-os/apply-login
echo "$(t 'cuenta %s creada (administradora)' "${usuario}")"
