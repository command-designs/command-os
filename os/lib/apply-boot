#!/usr/bin/env bash
# Command OS — arranque silencioso (x86: GRUB · Raspberry Pi: cmdline.txt/config.txt).
# Producto para clientes: del encendido al escritorio solo se ve el splash, sin texto del cargador,
# del kernel ni de systemd. Soporte técnico: Esc en GRUB muestra el menú y Esc en el splash muestra
# el arranque detallado.
# Lo ejecutan install.sh, el paquete al instalarse o actualizarse y el gancho de pacman de GRUB
# (cada actualización de GRUB devuelve los textos "Loading Linux…"). Idempotente.
set -euo pipefail

SILENT_ARGS="quiet splash loglevel=3 rd.udev.log_level=3 systemd.show_status=auto rd.systemd.show_status=auto vt.global_cursor_default=0"
# VirtualBox: todo el arranque a 1280x720 (vboxvideo pondría 1024x768). Con render por software,
# 720p es el mejor equilibrio; labwc reutiliza ese modo (<reuseOutputMode>): sin pantallazo negro.
if [[ "$(systemd-detect-virt 2>/dev/null || true)" == "oracle" ]]; then
  SILENT_ARGS="${SILENT_ARGS} video=1280x720"
fi

native_mode() {  # ANCHOxALTO del modo preferido de la pantalla (la interna si hay); vacío si no se sabe
  local c m best=""
  for c in /sys/class/drm/card*-*; do
    [[ "$(cat "${c}/status" 2>/dev/null)" == connected ]] || continue
    m=$(head -n1 "${c}/modes" 2>/dev/null)
    [[ "${m}" =~ ^[0-9]+x[0-9]+$ ]] || continue
    case "${c##*/}" in *eDP*|*LVDS*|*DSI*) printf '%s' "${m}"; return ;; esac
    [[ -n "${best}" ]] || best=${m}
  done
  printf '%s' "${best}"
}

# Tema de GRUB (piezas de os/branding/grub, build/make-grub-theme.py). GRUB no escala nada: las
# fuentes y las medidas se generan aquí para el alto de la pantalla del equipo (1080 px = medidas
# base), así el menú se ve igual en 1366x768 que en 2560x1600. Sin la fuente, se queda sin tema.
THEME_DIR=/boot/grub/themes/command
# Idioma del sistema (/etc/locale.conf, command-os-idioma) para el menú y los textos del tema: desde
# un gancho de pacman no llega su LANG.
LANG_SISTEMA=$(sed -nE 's/^LANG=//p' /etc/locale.conf 2>/dev/null | tr -d '"' | tail -n1)
t() {  # t TEXTO -> traducido al idioma del sistema (os/po/) o el original
  LC_ALL=${LANG_SISTEMA:-C} LANGUAGE="" TEXTDOMAIN=command-os TEXTDOMAINDIR=/usr/share/locale \
    gettext -- "$1" 2>/dev/null || printf '%s' "$1"
}
# El gancho del disco cifrado (os/initcpio/hooks/command-os-cifrado) pide la contraseña en el idioma
# del sistema, pero el initramfs no lee locale.conf (y rehacerlo en cada cambio de idioma tarda): se le
# pasa en la línea del kernel, command-os.idioma=es|en. Sin el parámetro, castellano.
idioma=${LANG_SISTEMA%%_*}
[[ "${idioma}" =~ ^[a-z]{2,3}$ ]] || idioma=es
IDIOMA_ARG="command-os.idioma=${idioma}"
THEME_FONT=/usr/share/fonts/TTF/JetBrainsMonoNLNerdFont-Regular.ttf
# Como en lenguaje.html: las entradas del menú en Geist (la paleta de comandos) y los rótulos en mono
# de peso 500 y en mayúsculas. La Geist variable sale en su peso por defecto, 400. Sin ellas, la mono.
MENU_FONT=/usr/share/fonts/command-os/Geist[wght].ttf
LABEL_FONT=/usr/share/fonts/TTF/JetBrainsMonoNLNerdFont-Medium.ttf
# Latín, puntuación, flechas y cajas (el editor y la consola de GRUB dibujan recuadros).
FONT_RANGES=0x20-0x7E,0xA0-0x17F,0x2010-0x2027,0x2190-0x2193,0x2500-0x257F

make_grub_theme() {  # make_grub_theme ALTO_PANTALLA -> 0 si el tema queda listo
  local h=$1 k
  command -v grub-mkfont >/dev/null && [[ -f "${THEME_FONT}" ]] || return 1
  k=$(( h * 1000 / 1080 ))
  (( k < 700 )) && k=700
  (( k > 2000 )) && k=2000
  p() { echo $(( $1 * k / 1000 )); }
  # Wordmark de 300 px a 1080 px de alto; GRUB no escala imágenes: el más cercano de los generados.
  local lw lh
  lw=$(( ($(p 300) + 10) / 20 * 20 ))
  (( lw < 200 )) && lw=200
  (( lw > 600 )) && lw=600
  install -d "${THEME_DIR}"
  rm -f "${THEME_DIR}"/*.pf2 "${THEME_DIR}"/*.png
  cp /usr/share/command-os/grub/{panel,sel,thumb}_*.png "${THEME_DIR}/" || return 1
  cp "/usr/share/command-os/grub/logo-${lw}.png" "${THEME_DIR}/logo.png" || return 1
  cp /usr/share/command-os/wallpapers/command-void.png "${THEME_DIR}/fondo.png" || return 1
  lh=$(( lw * 223 / 1498 ))
  local name size font
  for name in menu:20 texto:14 consola:18; do
    size=$(p "${name#*:}")
    case "${name%%:*}" in
      menu) font=${MENU_FONT} ;;
      texto) font=${LABEL_FONT} ;;
      *) font=${THEME_FONT} ;;
    esac
    [[ -f "${font}" ]] || font=${THEME_FONT}
    grub-mkfont -s "${size}" -n "cmd-${name%%:*}" -r "${FONT_RANGES}" \
      -o "${THEME_DIR}/cmd-${name%%:*}.pf2" "${font}" || return 1
  done
  # Rótulos en mayúsculas (el %d de la cuenta atrás, en minúscula: GRUB lo cambia por los segundos).
  local cuenta ayuda
  cuenta=$(t 'arranca en %d s'); cuenta=${cuenta^^}; cuenta=${cuenta//%D/%d}
  ayuda=$(t '↑ ↓  elegir      intro  arrancar      e  editar      c  consola'); ayuda=${ayuda^^}
  # Bloque centrado: wordmark, hueco, panel del menú (4 entradas a la vista; si hay más, barra de
  # desplazamiento; + 2 × 14: el borde arriba y abajo, que mide lo que el chaflán de las piezas
  # panel_*, C en build/make-grub-theme.py) y cuenta atrás.
  local gap ih sp pad mh half
  gap=$(p 44); ih=$(p 44); sp=$(p 4); pad=$(p 10); mh=$(( 4 * (ih + sp) + 2 * pad + 2 * 14 ))
  half=$(( (lh + gap + mh) / 2 ))
  cat > "${THEME_DIR}/theme.txt" <<EOF
# Command OS — tema de GRUB para pantallas de ${h} px de alto. Lo genera /usr/lib/command-os/apply-boot
# (al instalar o actualizar command-os o GRUB): no editar a mano.
title-text: ""
desktop-image: "fondo.png"
desktop-image-scale-method: "crop"
desktop-color: "#0e0e0e"
terminal-font: "cmd-consola"
terminal-left: "4%"
terminal-top: "4%"
terminal-width: "92%"
terminal-height: "92%"
terminal-border: "0"

+ image {
  file = "logo.png"
  left = 50%-$(( lw / 2 ))
  top = 50%-${half}
  width = ${lw}
  height = ${lh}
}

+ boot_menu {
  left = 50%-$(p 330)
  top = 50%-$(( half - lh - gap ))
  width = $(p 660)
  height = ${mh}
  menu_pixmap_style = "panel_*.png"
  item_font = "cmd-menu"
  selected_item_font = "cmd-menu"
  item_color = "#a3a09a"
  selected_item_color = "#edebe6"
  selected_item_pixmap_style = "sel_*.png"
  item_height = ${ih}
  item_spacing = ${sp}
  item_padding = ${pad}
  icon_width = 0
  icon_height = 0
  item_icon_space = $(p 18)
  scrollbar = true
  scrollbar_width = $(p 4)
  scrollbar_thumb = "thumb_*.png"
}

+ label {
  id = "__timeout__"
  left = 0
  top = 50%+$(( lh + gap + mh - half + $(p 18) ))
  width = 100%
  height = $(p 24)
  align = "center"
  font = "cmd-texto"
  color = "#a3a09a"
  text = "${cuenta}"
}

+ label {
  left = 0
  top = 100%-$(p 56)
  width = 100%
  height = $(p 24)
  align = "center"
  font = "cmd-texto"
  color = "#85827c"
  text = "${ayuda}"
}
EOF
}

add_args() {  # add_args "línea actual" -> añade los SILENT_ARGS que falten (no quita nada)
  local line="$1" arg
  for arg in ${SILENT_ARGS}; do
    [[ " ${line} " == *" ${arg} "* ]] || line="${line:+${line} }${arg}"
  done
  printf '%s' "${line}"
}

con_idioma() {  # con_idioma "línea" -> la línea con un solo command-os.idioma=, el del sistema
  local -a args
  local arg out=""
  read -ra args <<< "$1"
  for arg in "${args[@]}"; do
    [[ "${arg}" == command-os.idioma=* ]] || out="${out:+${out} }${arg}"
  done
  printf '%s' "${out:+${out} }${IDIOMA_ARG}"
}

if [[ -f /etc/default/grub ]]; then
  set_grub() {  # set_grub CLAVE 'valor' — reemplaza o añade
    if grep -qE "^#?${1}=" /etc/default/grub; then
      sed -i -E "s|^#?${1}=.*|${1}=${2}|" /etc/default/grub
    else
      echo "${1}=${2}" >> /etc/default/grub
    fi
  }
  set_grub GRUB_DISTRIBUTOR '"Command OS"'
  if [[ -f /etc/command-os/dualboot ]]; then
    # Dual boot con Windows (build/x86/install-dualboot.sh): menú visible para elegir. La entrada
    # de Windows la pone /etc/grub.d/35_command-os-windows.
    set_grub GRUB_TIMEOUT 5
    set_grub GRUB_TIMEOUT_STYLE menu
  else
    # Menú oculto: espera 1 s en silencio; Esc lo muestra (recuperación e instantáneas).
    set_grub GRUB_TIMEOUT 1
    set_grub GRUB_TIMEOUT_STYLE hidden
  fi
  # GRUB 2.16 (/etc/grub.d/31_efi_bootnext) copia en el menú todas las entradas de la NVRAM tal como
  # estaban al generarlo: USB de instalación, discos sueltos y Windows repetido. Sobran: Windows ya
  # tiene su entrada y el resto está en el menú de arranque de la BIOS.
  set_grub GRUB_DISABLE_BOOTNEXT true
  set_grub GRUB_TERMINAL_OUTPUT gfxterm
  # A la resolución nativa de la pantalla (algunos firmwares arrancan en 1024x768); si el firmware
  # no tiene ese modo, GRUB pasa a «auto».
  # COMMAND_OS_PANTALLA=ANCHOxALTO fija la pantalla (pruebas: VM y tests/escritorio.sh); «generica»
  # no mira la de esta máquina (imagen para cualquier equipo, build-image.sh): «auto» y medidas de
  # 1080. En el equipo, la siguiente actualización de GRUB o de command-os lo ajusta a su pantalla.
  case "${COMMAND_OS_PANTALLA:-}" in
    generica) mode="" ;;
    "") mode=$(native_mode) ;;
    *) mode=${COMMAND_OS_PANTALLA} ;;
  esac
  set_grub GRUB_GFXMODE "${mode:+${mode},}auto"
  set_grub GRUB_GFXPAYLOAD_LINUX keep
  # Fondo sin tema (si no se pudo generar): el tema usa el mismo, recortado sin deformar. Va en
  # /boot/grub: con el disco cifrado, GRUB solo lee /boot (la raíz no la descifra).
  install -Dm 644 /usr/share/command-os/wallpapers/command-void.png /boot/grub/command-os-fondo.png
  set_grub GRUB_BACKGROUND '"/boot/grub/command-os-fondo.png"'
  height=${mode#*x}
  if make_grub_theme "${height:-1080}"; then
    set_grub GRUB_THEME "\"${THEME_DIR}/theme.txt\""
    set_grub GRUB_FONT "\"${THEME_DIR}/cmd-consola.pf2\""
  else
    echo "command-os: aviso: sin tema de GRUB (falta grub-mkfont o la fuente JetBrains Mono)" >&2
    sed -i -E '/^GRUB_(THEME|FONT)=/d' /etc/default/grub
  fi
  set_grub GRUB_COLOR_NORMAL '"light-gray/black"'
  set_grub GRUB_COLOR_HIGHLIGHT '"light-red/black"'
  current=$(sed -nE 's/^GRUB_CMDLINE_LINUX_DEFAULT="(.*)"/\1/p' /etc/default/grub)
  set_grub GRUB_CMDLINE_LINUX_DEFAULT "\"$(add_args "${current}")\""
  # El idioma, en GRUB_CMDLINE_LINUX (como cryptdevice=): también lo llevan las entradas de
  # recuperación y las de las instantáneas, que también piden la contraseña del disco.
  current=$(sed -nE 's/^GRUB_CMDLINE_LINUX="(.*)"/\1/p' /etc/default/grub)
  set_grub GRUB_CMDLINE_LINUX "\"$(con_idioma "${current}")\""
  # Sin "Loading Linux ..." / "Loading initial ramdisk ...".
  if [[ -f /etc/grub.d/10_linux ]]; then
    sed -i '/echo.*"\$message"/d' /etc/grub.d/10_linux
  fi
  if [[ -f /boot/grub/grub.cfg ]] && command -v grub-mkconfig >/dev/null; then
    # Submenú de las instantáneas (grub-btrfs; install.sh pone el nombre al instalarlo).
    if [[ -f /etc/default/grub-btrfs/config ]]; then
      submenu=$(t 'Command OS: instantáneas (volver atrás)')
      sed -i -E "s|^#?GRUB_BTRFS_SUBMENUNAME=.*|GRUB_BTRFS_SUBMENUNAME=\"${submenu//|/-}\"|" \
        /etc/default/grub-btrfs/config
    fi
    # En el idioma del sistema («Opciones avanzadas…»).
    LANG=${LANG_SISTEMA:-C} grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 \
      || echo "command-os: aviso: grub-mkconfig falló; el menú de arranque no se ha regenerado" >&2
  fi
fi

if [[ -f /boot/cmdline.txt ]]; then
  # Raspberry Pi: el kernel escribe en tty3 en vez de en la pantalla (consola serie intacta).
  line=$(tr '\n' ' ' < /boot/cmdline.txt | sed -E 's/\bconsole=tty1\b/console=tty3/; s/ +/ /g; s/ $//')
  printf '%s\n' "$(add_args "${line}")" > /boot/cmdline.txt
fi
if [[ -f /boot/config.txt ]]; then
  # Sin el cuadro arcoíris del firmware al encender.
  if grep -qE '^disable_splash=' /boot/config.txt; then
    sed -i -E 's/^disable_splash=.*/disable_splash=1/' /boot/config.txt
  else
    echo 'disable_splash=1' >> /boot/config.txt
  fi
fi
exit 0
