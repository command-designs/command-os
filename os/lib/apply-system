#!/usr/bin/env bash
# Command OS — aplica todo lo de sistema que no se resuelve copiando ficheros: base de dconf,
# carpetas de iconos, identidad, splash en el initramfs y arranque silencioso. Lo ejecuta el
# paquete command-os al instalarse y en cada actualización (command-os.install). Idempotente.
set -uo pipefail

warn() { echo "command-os: aviso: $*" >&2; }

# Restos de la instalación anterior a paquete (install.sh copiaba a mano): fuera, para que no
# tapen a los del paquete (/usr/local/bin va antes que /usr/bin en el PATH).
rm -f /usr/local/bin/command-os-* /etc/pacman.d/hooks/command-os-icon-folders.hook \
  /etc/systemd/system/plymouth-quit.service.d/retain-splash.conf
rmdir /etc/systemd/system/plymouth-quit.service.d 2>/dev/null || true

dconf update || warn "dconf update falló"
/usr/bin/command-os-icon-folders grey || warn "no se pudo cambiar el color de las carpetas"
/usr/lib/command-os/apply-identity || warn "no se pudo aplicar la identidad del sistema"

# Splash: tema de Command y gancho de plymouth en el initramfs (justo después de systemd, en el
# initramfs de systemd, o de udev, en el clásico). Solo se regenera el initramfs si algo cambia.
regen=0
if ! grep -qs '^Theme=command$' /etc/plymouth/plymouthd.conf; then
  install -d /etc/plymouth
  printf '[Daemon]\nTheme=command\nShowDelay=0\n' > /etc/plymouth/plymouthd.conf
  regen=1
fi
if [[ -f /etc/mkinitcpio.conf ]] && ! grep -qE '^HOOKS=.*\bplymouth\b' /etc/mkinitcpio.conf; then
  if grep -qE '^HOOKS=.*\bsystemd\b' /etc/mkinitcpio.conf; then
    sed -i -E '/^HOOKS=/ s/\bsystemd\b/systemd plymouth/' /etc/mkinitcpio.conf
  else
    sed -i -E '/^HOOKS=/ s/\budev\b/udev plymouth/' /etc/mkinitcpio.conf
  fi
  regen=1
fi
if (( regen )) && command -v mkinitcpio >/dev/null; then
  mkinitcpio -P >/dev/null 2>&1 || warn "mkinitcpio falló; revisar con 'mkinitcpio -P'"
fi

/usr/lib/command-os/apply-boot || warn "no se pudo aplicar el arranque silencioso"
# Entrada al equipo (greetd): asistente, inicio de sesión o inicio automático; migra los equipos
# que entraban con agetty --autologin.
/usr/lib/command-os/apply-login || warn "no se pudo configurar la entrada al equipo"
# Fecha validada de Arch y repositorio de Command OS (la fecha puede venir nueva con el paquete).
/usr/lib/command-os/apply-repos || warn "no se pudieron ajustar los repositorios"

# Aplicaciones de la tienda (Flatpak, remoto Flathub de serie en el paquete flatpak): que se vean con
# el tema de Command OS. Pueden leer, solo eso, los archivos del tema de ~/.config/gtk-3.0 y gtk-4.0 (las
# copias de command-os-user-setup, con los chaflanes y los botones de la barra de título); no la carpeta,
# que guarda también los marcadores de Thunar. El modo oscuro y el tema GTK los toman de dconf por el
# portal de ajustes.
if command -v flatpak >/dev/null; then
  flatpak override --system \
    --filesystem=xdg-config/gtk-3.0/gtk.css:ro --filesystem=xdg-config/gtk-3.0/settings.ini:ro \
    --filesystem=xdg-config/gtk-4.0/gtk.css:ro --filesystem=xdg-config/gtk-4.0/settings.ini:ro \
    --filesystem=xdg-config/gtk-3.0/chaflanes:ro --filesystem=xdg-config/gtk-4.0/chaflanes:ro \
    --filesystem=xdg-config/gtk-3.0/botones:ro --filesystem=xdg-config/gtk-4.0/botones:ro \
    || warn "no se pudo dar a las apps Flatpak el tema del sistema"
fi

# Comprobación periódica de actualizaciones: se activa una sola vez (marca en /var/lib/command-os);
# si el usuario la desactiva con `systemctl disable`, una actualización no la vuelve a activar. Solo se
# arranca con systemd en marcha y fuera de un chroot (allí `systemctl` hablaría con el anfitrión).
if [[ ! -e /var/lib/command-os/aviso-actualizaciones ]]; then
  if systemctl enable command-os-check-updates.timer >/dev/null 2>&1; then
    install -d /var/lib/command-os
    touch /var/lib/command-os/aviso-actualizaciones
    if [[ -d /run/systemd/system ]] && ! systemd-detect-virt --chroot --quiet; then
      systemctl start --no-block command-os-check-updates.timer >/dev/null 2>&1 || true
    fi
  else
    warn "no se pudo activar la comprobación de actualizaciones"
  fi
fi

# Hora por la red (systemd-timesyncd, servidores de Arch): sin ella, un reloj del equipo que va mal
# (pila gastada, otra zona) no se corrige nunca. Una sola vez, como la de arriba: si alguien la
# desactiva, una actualización no la vuelve a activar. Si el equipo ya usa otro cliente de hora
# (chrony, ntpd, openntpd), se respeta: chronyd y timesyncd se excluyen y se pararían el uno al otro.
otro_ntp=""
for s in chronyd ntpd openntpd; do
  systemctl is-enabled --quiet "${s}.service" 2>/dev/null && otro_ntp=${s}
done
if [[ ! -e /var/lib/command-os/hora-por-red && -n "${otro_ntp}" ]]; then
  install -d /var/lib/command-os
  touch /var/lib/command-os/hora-por-red
elif [[ ! -e /var/lib/command-os/hora-por-red ]]; then
  if systemctl enable systemd-timesyncd.service >/dev/null 2>&1; then
    install -d /var/lib/command-os
    touch /var/lib/command-os/hora-por-red
    if [[ -d /run/systemd/system ]] && ! systemd-detect-virt --chroot --quiet; then
      systemctl start --no-block systemd-timesyncd.service >/dev/null 2>&1 || true
    fi
  else
    warn "no se pudo activar la hora por la red (systemd-timesyncd)"
  fi
fi

# Bluetooth: el servicio activado (para poder encenderlo desde la barra) y el adaptador apagado al
# arrancar (AutoEnable=false de bluez; blueman no guarda el estado, copia el del adaptador). Gasta menos
# batería y no anuncia el equipo sin que nadie lo pida. Una sola vez, como los de arriba: lo que cambie
# quien administra el equipo (main.conf, `systemctl disable`) no lo deshace una actualización.
if [[ ! -e /var/lib/command-os/bluetooth && -f /etc/bluetooth/main.conf ]]; then
  if grep -qE '^#?AutoEnable=' /etc/bluetooth/main.conf; then
    sed -i -E 's/^#?AutoEnable=.*/AutoEnable=false/' /etc/bluetooth/main.conf
  else
    printf '\n[Policy]\nAutoEnable=false\n' >> /etc/bluetooth/main.conf
  fi
  if systemctl enable bluetooth.service >/dev/null 2>&1; then
    install -d /var/lib/command-os
    touch /var/lib/command-os/bluetooth
    if [[ -d /run/systemd/system ]] && ! systemd-detect-virt --chroot --quiet; then
      systemctl start --no-block bluetooth.service >/dev/null 2>&1 || true
    fi
  else
    warn "no se pudo activar el servicio de Bluetooth"
  fi
fi
exit 0
