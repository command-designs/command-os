# Command OS: mira si hay actualizaciones (lib/check-updates). La instancia es el modo: «auto» (el
# temporizador y el gancho de pacman; respeta las conexiones de datos medidos) o «manual» (el clic
# derecho del aviso; polkit deja lanzarla a quien esté en el equipo).
[Unit]
Description=Command OS: comprobar actualizaciones (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/lib/command-os/check-updates %i
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=5min
# Solo escribe su estado (/var/lib/command-os) y su copia de la base de datos de pacman.
StateDirectory=command-os
StateDirectoryMode=0755
CacheDirectory=command-os
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
