#!/usr/bin/ash
# shellcheck shell=dash
# Command OS — abre el disco cifrado pidiendo la contraseña dentro del splash (Plymouth): en el
# idioma del sistema, sin límite de intentos y avisando si es incorrecta. Va justo antes del gancho encrypt
# de Arch, que al ver el volumen ya abierto no hace nada («Device … already exists»): de él solo se
# usan los módulos y cryptsetup que mete en el initramfs. Sin Plymouth, pregunta en la consola.
#
# Lee el mismo parámetro que encrypt: cryptdevice=UUID=<luks>:<nombre>. Las opciones del volumen
# (allow-discards) van guardadas en la cabecera LUKS2 (build/x86/lib.sh: luks_root), no aquí.
# Acepta la clave de recuperación con o sin los guiones o espacios con que se enseña (48 cifras).

# Ojo: el busybox del initramfs es reducido (sin tr ni stty): aquí solo shell, cryptsetup y plymouth
# (tests/discos.sh prueba el gancho con un PATH que solo tiene eso).

# solo_cifras TEXTO — las cifras de TEXTO, sin nada más.
solo_cifras() {
    local resto=$1 c r=""
    while [ -n "${resto}" ]; do
        c=${resto%"${resto#?}"}
        resto=${resto#?}
        case "${c}" in [0-9]) r="${r}${c}" ;; esac
    done
    printf '%s' "${r}"
}

# cifrado_abrir DISPOSITIVO NOMBRE CLAVE — 0 si la clave abre el volumen.
cifrado_abrir() {
    local solo
    printf '%s' "$3" | cryptsetup open --type luks --key-file=- "$1" "$2" >/dev/null 2>&1 && return 0
    # Clave de recuperación tecleada con separadores: solo cifras, guiones y espacios, 48 cifras.
    case "$3" in *[!0-9\ -]*) return 1 ;; esac
    solo=$(solo_cifras "$3")
    [ "${#solo}" -eq 48 ] && [ "${solo}" != "$3" ] || return 1
    printf '%s' "${solo}" | cryptsetup open --type luks --key-file=- "$1" "$2" >/dev/null 2>&1
}

# idioma_arranque [LÍNEA] — «en» o «es», del parámetro command-os.idioma= de la línea del kernel (lo
# pone lib/apply-boot con el idioma del sistema); castellano si no está. Sin LÍNEA, /proc/cmdline.
idioma_arranque() {
    local linea=$1 p
    [ $# -gt 0 ] || read -r linea < /proc/cmdline 2>/dev/null || linea=""
    for p in ${linea}; do
        case "${p}" in command-os.idioma=en) echo en; return 0 ;; esac
    done
    echo es
}

# textos_cifrado IDIOMA — los textos del gancho: TEXTO_PEDIR, TEXTO_MALA y TEXTO_ABRIENDO. Aquí no hay
# gettext: van escritos en cada idioma. command.script reconoce los dos primeros por su contenido y
# los enseña como imagen (build/make-plymouth-textos.py): si cambian, cambiarlos también allí.
textos_cifrado() {
    case "$1" in
        en)
            TEXTO_PEDIR="Disk password (or recovery key)"
            TEXTO_MALA="Wrong password. Type it again"
            TEXTO_ABRIENDO="cmd-os: unlocking the disk" ;;
        *)
            TEXTO_PEDIR="Contraseña del disco (o clave de recuperación)"
            TEXTO_MALA="Contraseña incorrecta. Vuelve a escribirla"
            TEXTO_ABRIENDO="cmd-os: desbloqueando el disco" ;;
    esac
}

con_splash() { command -v plymouth >/dev/null 2>&1 && plymouth --ping 2>/dev/null; }

# cifrado_pedir TEXTO — imprime lo que se teclee (en el splash o, sin él, en la consola).
cifrado_pedir() {
    local clave
    if con_splash; then
        plymouth ask-for-password --prompt="$1"
    else
        printf '\n%s: ' "$1" >&2
        # shellcheck disable=SC3045  # el ash de busybox sí tiene read -s (sin eco)
        read -rs clave || return 1
        printf '\n' >&2
        printf '%s' "${clave}"
    fi
}

run_hook() {
    local dispositivo nombre texto clave fallos=0
    [ -n "${cryptdevice}" ] || return 0
    IFS=: read -r dispositivo nombre _ <<EOF
$cryptdevice
EOF
    [ -n "${nombre}" ] && [ ! -b "/dev/mapper/${nombre}" ] || return 0
    dispositivo=$(resolve_device "${dispositivo}" "$(getarg rootdelay)") || return 0
    modprobe -a -q dm-crypt >/dev/null 2>&1
    cryptsetup isLuks "${dispositivo}" >/dev/null 2>&1 || return 0

    textos_cifrado "$(idioma_arranque)"
    texto=${TEXTO_PEDIR}
    while :; do
        # Si no se puede preguntar (Plymouth no atiende, consola sin entrada) 5 veces seguidas, lo
        # deja al gancho encrypt de Arch: pregunta a su manera y, si tampoco puede, deja una consola
        # de emergencia. Sin esto, el arranque se quedaría en el splash para siempre.
        if ! clave=$(cifrado_pedir "${texto}"); then
            fallos=$((fallos + 1))
            if [ "${fallos}" -ge 5 ]; then
                echo "command-os-cifrado: no se puede pedir la contraseña; sigue el gancho encrypt" >&2
                return 0
            fi
            sleep 1
            continue
        fi
        fallos=0
        [ -n "${clave}" ] || continue
        con_splash && plymouth display-message --text="${TEXTO_ABRIENDO}"
        if cifrado_abrir "${dispositivo}" "${nombre}" "${clave}"; then
            break
        fi
        texto=${TEXTO_MALA}
    done
    clave=""
}

# vim: set ft=sh ts=4 sw=4 et:
