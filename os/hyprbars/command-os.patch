+#define WLR_USE_UNSTABLE
+
+#include <hyprland/src/desktop/view/Window.hpp>
+#include <hyprland/src/desktop/view/WLSurface.hpp>
+
+// what each client asked for is private to the protocols
+#define private public
+#include <hyprland/src/protocols/XDGShell.hpp>
+#include <hyprland/src/protocols/XDGDecoration.hpp>
+#include <hyprland/src/protocols/ServerDecorationKDE.hpp>
+#undef private
+
+#include "barDeco.hpp"
+
+// A client gets a bar only if it asked for server-side decorations (xdg-decoration or KDE's protocol), as
+// labwc decides it. Hyprland answers "server side" to everyone, so what the client requested is what
+// tells: GTK 4 and libadwaita windows with a header bar ask for client side, or never ask.
+bool clientDrawsOwnDecorations(PHLWINDOW window) {
+    if (!window || window->m_isX11)
+        return false;
+
+    if (PROTO::xdgDecoration && window->m_xdgSurface && window->m_xdgSurface->m_toplevel) {
+        const auto TOPLEVEL = window->m_xdgSurface->m_toplevel->m_resource->resource();
+        const auto IT       = PROTO::xdgDecoration->m_decorations.find(TOPLEVEL);
+        if (IT != PROTO::xdgDecoration->m_decorations.end() && IT->second)
+            return IT->second->mostRecentlyRequested == ZXDG_TOPLEVEL_DECORATION_V1_MODE_CLIENT_SIDE;
+    }
+
+    if (PROTO::serverDecorationKDE && window->wlSurface()) {
+        const auto SURFACE = window->wlSurface()->resource();
+        for (const auto& deco : PROTO::serverDecorationKDE->m_decos) {
+            if (deco && deco->m_surf == SURFACE)
+                return deco->m_mostRecentlyRequested != ORG_KDE_KWIN_SERVER_DECORATION_MODE_SERVER;
+        }
+    }
+
+    return true;
+}
