+// the SVGs are rasterized at the monitor's scale the first time each state is drawn
+void CHyprBar::renderSvgButton(SHyprButton& button, const CBox& box, size_t idx, const float scale, const float a) {
+    static constexpr std::array<const char*, SVG_STATES> SUFFIX = {"-active.svg", "-inactive.svg", "_hover-active.svg"};
+
+    if (button.svgScale != scale) {
+        button.svgTex   = {};
+        button.svgTried = {};
+        button.svgScale = scale;
+    }
+
+    const auto PWINDOW = m_pWindow.lock();
+    const bool TOGGLED = !button.svgToggled.empty() && (Fullscreen::controller()->getFullscreenModes(PWINDOW).internal == Fullscreen::FSMODE_MAXIMIZED || PWINDOW->m_ruleApplicator->m_tagKeeper.isTagged("maximizada", true));
+    const auto STATE   = m_iHoveredButton == (int)idx ? SVG_HOVER : m_bWindowHasFocus ? SVG_ACTIVE : SVG_INACTIVE;
+    const auto SLOT    = (TOGGLED ? SVG_STATES : 0) + STATE;
+
+    if (!button.svgTried[SLOT]) {
+        button.svgTried[SLOT] = true;
+        button.svgTex[SLOT]   = loadSvg((TOGGLED ? button.svgToggled : button.svg) + SUFFIX[STATE], box.size());
+    }
+
+    if (button.svgTex[SLOT])
+        g_pHyprOpenGL->renderTexture(button.svgTex[SLOT], box, {.a = a});
+}
