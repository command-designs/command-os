+            return Config::Lua::Bindings::Internal::configError(L, "add_button: width must be a positive number");
+
+        button.width = lua_tonumber(L, -1);
+    }
+
+    {
+        Hyprutils::Utils::CScopeGuard x([L] { lua_pop(L, 1); });
+
+        lua_getfield(L, 1, "action");
