# Notificaciones de Command OS (docs/DISENO.md, marca v2): panel en Graphite con filo de 1 px.
# Crítica: filo Red Hot de 2 px (el texto ya dice qué pasa). Barra de progreso en Signal Red.
font=Geist 11
background-color=#151515
text-color=#edebe6
border-color=#2a2a2a
progress-color=over #a51500
border-size=1
border-radius=0
padding=12
margin=8
width=340
default-timeout=5000
anchor=top-right
layer=overlay
on-notify=exec command-os-sound notify

[urgency=low]
text-color=#a3a09a
border-color=#2a2a2a

[urgency=critical]
on-notify=exec command-os-sound critical
border-color=#f5482c
border-size=2
default-timeout=0
