<?xml version="1.0" encoding="UTF-8"?>
<!--
  Command OS — menús de labwc (labwc-menu(5)). Voz de la marca: minúsculas y tono terminal.
  root-menu: clic derecho en el escritorio. client-menu: clic derecho en la barra de título o en el
  icono de la ventana (sustituye al de serie, que está en inglés).
-->
<openbox_menu>

  <menu id="root-menu">
    <separator label="cmd-os" />
    <item label="aplicaciones" icon="view-app-grid-symbolic">
      <action name="Execute" command="command-os-launcher" />
    </item>
    <item label="terminal" icon="utilities-terminal">
      <action name="Execute" command="kitty" />
    </item>
    <item label="archivos" icon="system-file-manager">
      <action name="Execute" command="thunar" />
    </item>
    <item label="navegador" icon="firefox">
      <action name="Execute" command="firefox" />
    </item>
    <item label="tienda de aplicaciones" icon="system-software-install">
      <action name="Execute" command="command-os-tienda" />
    </item>
    <separator />
    <item label="ajustes" icon="preferences-system">
      <action name="Execute" command="command-os-ajustes" />
    </item>
    <item label="recargar escritorio" icon="view-refresh">
      <action name="Reconfigure" />
    </item>
    <menu id="escritorios" label="escritorios" icon="preferences-desktop-display">
      <item label="nuevo escritorio" icon="list-add">
        <action name="Execute" command="command-os-desktops nuevo" />
      </item>
      <item label="quitar el último" icon="list-remove">
        <action name="Execute" command="command-os-desktops quitar" />
      </item>
    </menu>
    <item label="atajos de teclado" icon="preferences-desktop-keyboard-shortcuts">
      <action name="Execute" command="command-os-keys" />
    </item>
    <item label="acerca de cmd-os" icon="help-about">
      <action name="Execute" command="command-os-about" />
    </item>
    <separator />
    <item label="bloquear" icon="system-lock-screen">
      <action name="Execute" command="loginctl lock-session" />
    </item>
    <item label="energía" icon="system-shutdown">
      <action name="Execute" command="command-os-power" />
    </item>
  </menu>

  <menu id="client-menu">
    <item label="minimizar" icon="window-minimize-symbolic">
      <action name="Iconify" />
    </item>
    <item label="maximizar" icon="window-maximize-symbolic">
      <action name="ToggleMaximize" />
    </item>
    <item label="pantalla completa" icon="view-fullscreen-symbolic">
      <action name="ToggleFullscreen" />
    </item>
    <item label="siempre encima" icon="go-top-symbolic">
      <action name="ToggleAlwaysOnTop" />
    </item>
    <item label="en todos los escritorios" icon="view-pin-symbolic">
      <action name="ToggleOmnipresent" />
    </item>
    <!-- Los escritorios que existan en ese momento (command-os-desktops menu). -->
    <menu id="mover-a-escritorio" label="mover a escritorio" icon="go-next-symbolic"
          execute="command-os-desktops menu" />
    <separator />
    <item label="cerrar" icon="window-close-symbolic">
      <action name="Close" />
    </item>
  </menu>

</openbox_menu>
