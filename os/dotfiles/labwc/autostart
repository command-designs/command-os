# Command OS — arranque de la sesión (labwc-config(5)): labwc lo ejecuta con sh al iniciar.
# La salida de cada programa va al log de labwc ($XDG_RUNTIME_DIR/labwc.log, ver command-os-session).
# Waybar, swaync e hypridle no toman la nuestra de /etc/xdg: command-os-config les da la del usuario
# (si existe) o la de serie del paquete.

# La cuenta la prepara command-os-session (command-os-user-setup) antes de lanzar labwc.
# Primero la escala de cada pantalla: la barra y el fondo arrancan ya con su tamaño final.
command-os-pantallas aplicar
COMMAND_OS_FONDO=1 command-os-pantallas vigilar &
command-os-wallpaper
# La hoja de estilo de la barra lleva además los iconos de las aplicaciones fijadas (command-os-fijadas).
waybar --config "$(command-os-config waybar/config.jsonc)" \
  --style "$(command-os-fijadas generar "$(command-os-config waybar/style.css)")" &
swaync --config "$(command-os-config swaync/config.json)" --style "$(command-os-config swaync/style.css)" &
hypridle --config "$(command-os-config hypr/hypridle.conf)" &
swayosd-server &
wl-paste --watch cliphist store &
nm-applet --indicator &
/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
command-os-updates watch &
command-os-bateria watch &
command-os-sound boot &
