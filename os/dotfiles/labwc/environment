# Command OS — variables de la sesión de labwc (labwc-config(5)).
# Lo propio de cada máquina (distribución de teclado, VM) va en environment.d/local.env, que genera
# command-os-user-setup en cada inicio de sesión; labwc lo lee después de este archivo.

# Apps GTK y Qt con el tema de Command OS (gtk-3.0/gtk-4.0 en ~/.config y dconf de install.sh).
XCURSOR_THEME=Adwaita
XCURSOR_SIZE=24
QT_QPA_PLATFORMTHEME=gtk3
QT_QPA_PLATFORM=wayland;xcb

# Apps Electron y Firefox nativas en Wayland.
ELECTRON_OZONE_PLATFORM_HINT=auto
MOZ_ENABLE_WAYLAND=1

XKB_DEFAULT_LAYOUT=us
