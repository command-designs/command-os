{
    "layer": "top",
    "position": "top",
    "height": 30,
    "modules-left": ["custom/logo", "group/fijadas", "wlr/taskbar"],
    "modules-center": ["clock"],
    // Aplicaciones fijadas (group/fijadas y sus custom/fijada#fN): las escribe command-os-fijadas al
    // abrir la sesión y al cambiar la lista (lib/fijadas.py). Sin el archivo, la barra sale sin ellas.
    "include": ["$XDG_RUNTIME_DIR/command-os/barra/fijadas.jsonc"],
    "modules-right": ["custom/updates", "ext/workspaces", "cpu", "temperature", "memory", "network", "bluetooth", "pulseaudio", "battery", "tray", "custom/power"],

    // Los textos entre dobles llaves se traducen al abrir la sesión (command-os-config, docs/idioma.md).
    // Etiqueta en Smoke + valor en Ash, en mayúsculas como las lecturas de lenguaje.html (lo que
    // se traduce, con text_transform de Pango: las traducciones siguen en minúsculas). Colores de
    // la marca v2 (docs/DISENO.md). Los LED de estado (red, Bluetooth, versión nueva), en style.css.
    // Logo como fondo CSS (#custom-logo en style.css): el módulo `image` de Waybar 0.15 se
    // bloquea al arrancar y deja la barra invisible. Clic: lanzador de aplicaciones; clic derecho:
    // elegir una aplicación para fijarla en la barra.
    "custom/logo": {
        "format": " ",
        "tooltip-format": "{{aplicaciones · clic derecho: fijar una aplicación en la barra}}",
        "on-click": "command-os-launcher",
        "on-click-right": "command-os-fijadas fijar"
    },
    // Aviso de actualizaciones: oculto si no hay nada (el script devuelve texto vacío). Solo lee el
    // archivo que deja la comprobación del sistema (lib/check-updates, cada 6 horas y tras cada
    // operación de pacman): cada minuto no cuesta nada. La señal 8 lo refresca al momento. Clic: el panel de actualizaciones (qué hay y un botón para actualizar en una terminal); clic derecho: comprobar ahora.
    "custom/updates": {
        "exec": "command-os-updates status",
        "return-type": "json",
        "format": "{}",
        "interval": 60,
        "signal": 8,
        "on-click": "command-os-updates panel",
        "on-click-right": "command-os-updates check"
    },
    // Escritorios por el protocolo estándar ext-workspace (labwc lo implementa). Solo se ven si hay
    // más de uno (style.css oculta el botón cuando está solo); se crean y quitan con
    // command-os-desktops, que reescribe <desktops> en ~/.config/labwc/rc.xml.
    "ext/workspaces": {
        "format": "{name}",
        "sort-by-id": true,
        "on-click": "activate"
    },
    // Ventanas abiertas: clic para traerla o minimizarla, clic central para cerrarla.
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 16,
        "icon-theme": "Papirus-Dark",
        "tooltip-format": "{title}",
        "on-click": "minimize-raise",
        "on-click-middle": "close",
        "ignore-list": ["org.pulseaudio.pavucontrol", "blueman-manager"]
    },
    // Fecha (apagada) y hora: lo que se mira de un vistazo.
    "clock": {
        "format": "<span color='#85827c'>{0:%d.%m}</span>  {0:%H:%M}",
        "tooltip-format": "{0:%A %d %B %Y}"
    },
    // Telemetría: Warn al pasar del umbral de aviso, Red Hot al crítico (style.css).
    "cpu": {
        "format": "<span color='#85827c'>CPU</span> {usage}%",
        "interval": 5,
        "states": { "warning": 70, "critical": 90 }
    },
    "temperature": {
        "format": "<span color='#85827c'>TMP</span> {temperatureC}°",
        "critical-threshold": 80,
        "interval": 5
    },
    "memory": {
        "format": "<span color='#85827c'>MEM</span> {percentage}%",
        "interval": 5,
        "states": { "warning": 75, "critical": 90 },
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
    },
    "network": {
        "format-wifi": "<span color='#85827c'>NET</span> {essid} {signalStrength}%",
        "format-ethernet": "<span color='#85827c'>NET</span> ETH",
        "format-disconnected": "<span color='#85827c'>NET</span> <span text_transform='uppercase'>{{sin red}}</span>",
        "tooltip-format": "{ifname} · {ipaddr} · {{clic: conexiones}}",
        "on-click": "nm-connection-editor"
    },
    // Bluetooth: oculto si el equipo no tiene adaptador; apagado de serie (lib/apply-system). Con
    // dispositivos conectados, cuántos. Clic: los dispositivos (blueman); clic derecho: encender o apagar.
    "bluetooth": {
        "format": "<span color='#85827c'>BT</span> ON",
        "format-off": "<span color='#85827c'>BT</span> OFF",
        "format-disabled": "<span color='#85827c'>BT</span> OFF",
        "format-connected": "<span color='#85827c'>BT</span> {num_connections}",
        "format-no-controller": "",
        "tooltip-format": "{{clic: dispositivos · clic derecho: encender o apagar}}",
        "tooltip-format-connected": "{device_enumerate}\n{{clic: dispositivos · clic derecho: encender o apagar}}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "command-os-bluetooth panel",
        "on-click-right": "command-os-bluetooth cambiar"
    },
    "pulseaudio": {
        "format": "<span color='#85827c'>VOL</span> {volume}%",
        "format-muted": "<span color='#85827c'>VOL</span> MUTE",
        "on-click": "command-os-volume",
        "tooltip-format": "{desc} · {{clic: mezclador}}"
    },
    // Con la batería descargándose, el tiempo que queda; cargando, un +. Clic derecho: el panel de la
    // batería (límite de carga al 80 % si el portátil lo permite; command-os-bateria).
    "battery": {
        "format": "<span color='#85827c'>BAT</span> {capacity}%",
        "format-discharging": "<span color='#85827c'>BAT</span> {capacity}% <span color='#85827c'>{time}</span>",
        "format-charging": "<span color='#85827c'>BAT</span> {capacity}% +",
        "format-time": "{H}h{M:02}",
        "states": { "warning": 30, "critical": 15 },
        "tooltip-format": "{{clic derecho: ajustes de la batería}}",
        "on-click-right": "command-os-bateria panel"
    },
    "tray": { "spacing": 8 },
    // Menú de energía (bloquear · reiniciar · apagar), igual que Super+Escape.
    "custom/power": {
        "format": "󰐥",
        "tooltip-format": "{{energía}}",
        "on-click": "command-os-power"
    }
}
