{
    "layer": "top",
    "position": "top",
    "height": 30,
    "modules-left": ["custom/logo", "wlr/taskbar"],
    "modules-center": ["clock"],
    "modules-right": ["custom/updates", "ext/workspaces", "cpu", "temperature", "memory", "network", "pulseaudio", "battery", "tray", "custom/power"],

    // Etiqueta en cian (dato) + valor en hueso. Colores de docs/DISENO.md.
    // Logo como fondo CSS (#custom-logo en style.css): el módulo `image` de Waybar 0.15 se
    // bloquea al arrancar y deja la barra invisible. Clic: lanzador de aplicaciones.
    "custom/logo": {
        "format": " ",
        "tooltip-format": "aplicaciones",
        "on-click": "command-os-launcher"
    },
    // Aviso de actualizaciones: oculto si no hay nada (el script devuelve texto vacío). Solo lee el
    // archivo que deja la comprobación del sistema (lib/check-updates, cada 6 horas y tras cada
    // operación de pacman): cada minuto no cuesta nada. La señal 8 lo refresca al momento. Clic: actualizar en una terminal; clic derecho: comprobar ahora.
    "custom/updates": {
        "exec": "command-os-updates status",
        "return-type": "json",
        "format": "{}",
        "interval": 60,
        "signal": 8,
        "on-click": "command-os-updates update",
        "on-click-right": "command-os-updates check"
    },
    // Escritorios por el protocolo estándar ext-workspace (labwc lo implementa). Solo se ven si hay
    // más de uno (style.css oculta el botón cuando está solo); se crean y quitan con
    // command-os-desktops, que reescribe <desktops> en ~/.config/labwc/rc.xml.
    "ext/workspaces": {
        "format": "{name}",
        "sort-by-id": true,
        "on-click": "activate"
    },
    // Ventanas abiertas: clic para traerla o minimizarla, clic central para cerrarla.
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 16,
        "icon-theme": "Papirus-Dark",
        "tooltip-format": "{title}",
        "on-click": "minimize-raise",
        "on-click-middle": "close",
        "ignore-list": ["org.pulseaudio.pavucontrol"]
    },
    // Fecha (apagada) y hora: lo que se mira de un vistazo.
    "clock": {
        "format": "<span color='#6f6870'>{0:%d.%m}</span>  {0:%H:%M}",
        "tooltip-format": "{0:%A %d %B %Y}"
    },
    // Telemetría: ámbar al pasar del umbral de aviso, rojo al crítico (style.css).
    "cpu": {
        "format": "<span color='#5bbfc4'>cpu</span> {usage}%",
        "interval": 5,
        "states": { "warning": 70, "critical": 90 }
    },
    "temperature": {
        "format": "<span color='#5bbfc4'>tmp</span> {temperatureC}°",
        "critical-threshold": 80,
        "interval": 5
    },
    "memory": {
        "format": "<span color='#5bbfc4'>mem</span> {percentage}%",
        "interval": 5,
        "states": { "warning": 75, "critical": 90 },
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
    },
    "network": {
        "format-wifi": "<span color='#5bbfc4'>net</span> {essid} {signalStrength}%",
        "format-ethernet": "<span color='#5bbfc4'>net</span> eth",
        "format-disconnected": "<span color='#d13449'>net</span> sin red",
        "tooltip-format": "{ifname} · {ipaddr} · clic: conexiones",
        "on-click": "nm-connection-editor"
    },
    "pulseaudio": {
        "format": "<span color='#5bbfc4'>vol</span> {volume}%",
        "format-muted": "<span color='#d13449'>vol</span> mute",
        "on-click": "command-os-volume",
        "tooltip-format": "{desc} · clic: mezclador"
    },
    // Con la batería descargándose, el tiempo que queda; cargando, un +.
    "battery": {
        "format": "<span color='#5bbfc4'>bat</span> {capacity}%",
        "format-discharging": "<span color='#5bbfc4'>bat</span> {capacity}% <span color='#6f6870'>{time}</span>",
        "format-charging": "<span color='#5bbfc4'>bat</span> {capacity}% +",
        "format-time": "{H}h{M:02}",
        "states": { "warning": 30, "critical": 15 }
    },
    "tray": { "spacing": 8 },
    // Menú de energía (bloquear · reiniciar · apagar), igual que Super+Escape.
    "custom/power": {
        "format": "󰐥",
        "tooltip-format": "energía",
        "on-click": "command-os-power"
    }
}
