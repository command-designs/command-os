{
    "layer": "top",
    "position": "top",
    "height": 30,
    "modules-left": ["image#logo", "hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "memory", "network", "pulseaudio", "battery", "tray"],

    "image#logo": {
        "path": "/usr/share/command-os/logo/command-mark-32.png",
        "size": 16,
        "tooltip": false
    },
    "hyprland/workspaces": {
        "format": "{id}",
        "persistent-workspaces": { "*": 4 }
    },
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "{:%A %d %B %Y}"
    },
    "cpu": { "format": "cpu {usage}%", "interval": 5 },
    "memory": { "format": "mem {percentage}%", "interval": 5 },
    "network": {
        "format-wifi": "{essid}",
        "format-ethernet": "eth",
        "format-disconnected": "sin red",
        "tooltip-format": "{ifname} · {ipaddr}"
    },
    "pulseaudio": {
        "format": "vol {volume}%",
        "format-muted": "mute",
        "on-click": "pavucontrol"
    },
    "battery": {
        "format": "bat {capacity}%",
        "format-charging": "bat {capacity}% +",
        "states": { "critical": 15 }
    },
    "tray": { "spacing": 8 }
}
