# Command OS — traducción al inglés (docs/idioma.md). El original es el castellano.
# Se pone al día con `bash build/po.sh`; tests/idioma.sh comprueba que no falte nada.
msgid ""
msgstr ""
"Project-Id-Version: command-os\n"
"Report-Msgid-Bugs-To: \n"
"PO-Revision-Date: 2026-10-07 18:00+0200\n"
"Last-Translator: Command OS\n"
"Language-Team: Command OS\n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
